    <application
        android:name="com.za.toptitup.loginlibrary.utils.Topitup"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Top it Up"
        android:supportsRtl="false"

        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup,android:label,android:supportsRtl">

               <activity
            android:name="com.za.toptitup.loginlibrary.activitySplashScreen"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="Top it Up"
            android:launchMode="singleInstance"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />

            </intent-filter>

        </activity>

        <provider
            android:name="com.za.toptitup.loginlibrary.MyContentProvider"
            android:authorities="za.co.topitup"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="true"></provider>

        <activity
            android:name="com.za.toptitup.loginlibrary.activity_login"
            android:exported="true"
            android:label="Top it Up"
            android:theme="@style/AppTheme.FullScreen"
            android:windowSoftInputMode="stateAlwaysHidden" />

        <activity
            android:name="com.za.toptitup.loginlibrary.BaseActivity"
            android:label="Base Activity TIU"
            android:theme="@style/AppTheme.FullScreen" />


        <receiver
            android:name="com.za.toptitup.loginlibrary.utils.AlarmReciver"
            android:enabled="true"
            android:exported="true" />


        <receiver
            android:name="com.za.toptitup.loginlibrary.utils.BatteryReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="com.za.toptitup.loginlibrary.utils.ScreenStateReceiver"
            android:enabled="true"
            android:exported="true">


            <intent-filter>
                <action android:name="android.intent.action.ACTION_SCREEN_OFF" />
                <action android:name="android.intent.action.ACTION_SCREEN_ON" />
                <action android:name="android.intent.action.ACTION_BATTERY_CHANGED" />
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
            </intent-filter>
        </receiver>


        <activity
            android:name="com.za.toptitup.loginlibrary.activity_main"

            android:exported="true"
            android:hardwareAccelerated="true"
            android:theme="@style/AppTheme.FullScreen"
            android:windowSoftInputMode="stateAlwaysHidden" />



