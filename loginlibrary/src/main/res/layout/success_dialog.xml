<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/img_logo"
        android:visibility="visible"
        android:layout_marginTop="@dimen/margin20"
        android:layout_gravity="center_horizontal"
        android:src="@drawable/prov_cellc"
        android:layout_width="@dimen/spi_dark_dialog_img_layout_width"
        android:layout_height="@dimen/multi_voucher_img"/>

    <TextView
        android:visibility="gone"
        android:layout_marginTop="@dimen/margin10"
        android:layout_gravity="center_horizontal"
        android:textSize="@dimen/pad_25dp"
        android:text="Congratulation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:textSize="@dimen/margin20"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_activation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <TextView
        android:layout_margin="@dimen/margin10"
        android:textColor="@color/green"
        android:textSize="@dimen/pad_25dp"
        android:text="Updated Successfully"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView

        android:layout_marginBottom="@dimen/margin10"
        android:background="@drawable/edit_bg_gray"
        android:id="@+id/txt_ok"
        android:layout_marginTop="@dimen/pad_5dp"
        android:layout_gravity="center_horizontal"
        android:gravity="center"
        android:text="OK"
        android:textSize="@dimen/pad_15dp"
        android:layout_width="@dimen/pad_60dp"
        android:layout_height="@dimen/pad_30dp"/>

</LinearLayout>