<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/consume_300dp"
    android:layout_gravity="center"
    android:layout_height="@dimen/two_seventy">


    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/two_seventy" >
        <ImageView
            android:id="@+id/img_close"
            android:layout_marginTop="@dimen/margin10"
            android:layout_marginRight="@dimen/margin10"
            android:layout_alignParentRight="true"
            android:layout_width="@dimen/pad_50dp"
            android:src="@drawable/close_black"
            android:layout_height="@dimen/pad_50dp"/>

        <RelativeLayout
            android:id="@+id/view1"
            android:layout_width="@dimen/four_hundred"
            android:layout_height="@dimen/two_fifty"
            android:layout_alignParentBottom="true">

            <TextView
                android:gravity="center"
                android:textSize="@dimen/margin20"
                android:id="@+id/txt_desc"
                android:textColor="@color/black"
                android:text="Select Print Type"
                android:layout_marginTop="@dimen/loginMarginHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:layout_below="@+id/txt_desc"

                android:weightSum="2"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txt_short"
                    android:layout_marginLeft="@dimen/pad_15dp"
                    android:layout_marginRight="@dimen/pad_15dp"
                    android:layout_marginTop="@dimen/pad_50dp"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:textColor="@color/white"
                    android:textSize="@dimen/pad_15dp"
                    android:background="@drawable/background_blue"
                    android:text="Short Print"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pad_40dp"/>
                <TextView
                    android:layout_weight="1"
                    android:id="@+id/txt_long"
                    android:layout_marginLeft="@dimen/pad_15dp"
                    android:layout_marginRight="@dimen/pad_15dp"
                    android:layout_marginTop="@dimen/pad_50dp"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/pad_15dp"
                    android:background="@drawable/back_green"
                    android:layout_below="@+id/txt_desc"
                    android:text="Long Print"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/pad_40dp"/>
            </LinearLayout>


        </RelativeLayout>


    </RelativeLayout>

</RelativeLayout>