<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@color/white"

    android:layout_height="wrap_content"
    >

    <include
        layout="@layout/layout_tiu_header_new" />
    <RelativeLayout
        android:layout_above="@+id/ll_bottom"
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"
        android:layout_below="@+id/tiu_title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pad_10dp"
            android:layout_marginTop="@dimen/pad_10dp"
            android:layout_marginEnd="@dimen/pad_10dp"
            android:layout_marginBottom="@dimen/pad_10dp"
            android:gravity="center_horizontal"
            android:text="Retailer Payments"
            android:textColor="@color/red"
            android:textSize="@dimen/txt_25sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_marginTop="@dimen/pad_10dp"
            android:id="@+id/ll_date"
            android:weightSum="2"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_below="@+id/txtTitle"
            android:layout_height="wrap_content">

            <TextView
                android:gravity="center"
                android:layout_weight="1"
                android:id="@+id/date_month"
                android:layout_width="match_parent"
                android:layout_height="@dimen/retailer_button_height"
                android:ems="10"
                android:paddingLeft="5dp"
                android:textColorHint="@color/white"
                android:textColor="@color/white"
                android:textSize="@dimen/pad_15dp"
                android:layout_marginRight="@dimen/margin10"
                android:background="@drawable/background_blue"
                android:hint="Select Month"
                android:drawableLeft="@drawable/calendar"
                tools:ignore="MissingConstraints" />

            <TextView
                android:layout_marginLeft="@dimen/pad_10dp"
                android:background="@drawable/back_green"
                android:gravity="center"
                android:layout_weight="1"
                android:paddingLeft="5dp"
                android:textColorHint="@color/white"
                android:textColor="@color/white"
                android:textSize="@dimen/pad_15dp"
                android:id="@+id/date_display"
                android:layout_width="match_parent"
                android:layout_height="@dimen/retailer_button_height"
                android:ems="10"
                android:hint="Select Date"
                android:drawableLeft="@drawable/calendar"
                tools:ignore="MissingConstraints" />

        </LinearLayout>


        <TextView
            android:layout_marginTop="@dimen/pad_10dp"
            android:layout_below="@+id/ll_date"
            android:textSize="@dimen/pad_15dp"
            android:textColor="@color/black"
            android:id="@+id/txt_selected"
            android:text="Selected Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <androidx.appcompat.widget.SearchView
            android:layout_below="@+id/txt_selected"
            android:layout_marginTop="@dimen/pad_20dp"
            android:id="@+id/txt_account"
            android:layout_width="@dimen/dialog_no_net_height"
            android:layout_height="@dimen/pad_40dp"
            android:background="@drawable/textbox_background"
            android:iconifiedByDefault="false"
            android:queryHint="Enter Account#"
            android:theme="@style/SearchViewStyle"
            android:textColor="@color/black"
            android:textColorHint="@color/black" />
        <ListView
            android:paddingBottom="@dimen/pad_10dp"
            android:layout_marginTop="@dimen/pad_10dp"
            android:layout_below="@+id/txt_account"
            android:id="@+id/recycler_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

        <TextView
            android:layout_marginTop="@dimen/pad_20dp"
            android:layout_below="@+id/txt_account"
            android:id="@+id/txt_search"
            android:gravity="center"
            android:text="Search"
            android:layout_centerHorizontal="true"
            android:background="@drawable/edit_bg_gray"
            android:layout_width="@dimen/login_read_button_width"
            android:layout_height="@dimen/pad_40dp"/>


        <androidx.recyclerview.widget.RecyclerView
            android:paddingBottom="10dp"
            android:layout_marginTop="@dimen/pad_20dp"
            android:layout_below="@+id/txt_search"
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />
        <include
            layout="@layout/bottom_progress_bar"
            android:id="@+id/bottom_progress_layout"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_alignParentBottom="true"
            android:visibility="gone"/>

        <ListView
            android:visibility="gone"
            android:id="@+id/lst_reprint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/pad_10dp"
            android:layout_below="@+id/ll_date"
            />
    </RelativeLayout>
    <LinearLayout

        android:id="@+id/ll_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1c1c1c"
        android:orientation="horizontal"
        android:padding="5dp"
        android:layout_alignParentBottom="true">

        <Button
            android:layout_margin="@dimen/pad_5dp"
            android:background="@drawable/background_blue"
            android:id="@+id/btn_bottom_detail"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pad_50dp"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:onClick="onclick_btn_action"
            android:text="Print Detail" />

        <Button
            android:layout_margin="@dimen/pad_5dp"

            android:background="@drawable/back_green"

            android:id="@+id/btn_bottom_summary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/pad_50dp"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:onClick="onclick_btn_action"
            android:text="Print Summary"
            android:visibility="visible" />

    </LinearLayout>


</RelativeLayout>