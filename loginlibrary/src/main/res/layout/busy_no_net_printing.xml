<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/pad_15dp"
    android:layout_marginLeft="@dimen/pad_15dp"
    android:background="@color/black">


    <LinearLayout
        android:padding="@dimen/pad_15dp"
        android:id="@+id/ll_head"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="23 jan 2023"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />

            <TextView
                android:id="@+id/txt_account"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:maxLines="1"
                android:layout_marginTop="5dp"
                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <View
                android:visibility="gone"
                android:layout_below="@+id/txt_clock"

                android:layout_centerVertical="true"
                android:id="@+id/view2"
                android:layout_toRightOf="@+id/txt_account"
                android:layout_width="@dimen/view_2"
                android:layout_height="@dimen/headerViewHeight"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:id="@+id/txt_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_toRightOf="@+id/view2"
                android:maxLines="1"
                android:layout_marginTop="5dp"

                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />
            <TextView


                android:layout_alignParentRight="true"
                android:id="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="visible"
                android:text="2.3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/headtextSize" />

            <TextView
                android:layout_marginTop="5dp"

                android:layout_toLeftOf="@+id/view1"
                android:id="@+id/txt_user_name"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="username"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
            <View
                android:id="@+id/view1"
                android:layout_below="@+id/txt_app_version"

                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/txt_acc_type"
                android:layout_width="@dimen/view_2"
                android:layout_height="@dimen/headerViewHeight"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>
            <TextView
                android:layout_marginTop="5dp"

                android:layout_alignParentRight="true"
                android:id="@+id/txt_acc_type"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="Admin"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
        </RelativeLayout>


    </LinearLayout>

    <View

        android:id="@+id/view_line"
        android:layout_below="@+id/ll_head"
        android:layout_marginTop="@dimen/margin10"
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"

        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"/>

    <RelativeLayout
        android:layout_below="@+id/view_line"

        android:background="@color/grey_90"
        android:layout_margin="@dimen/margin10"
        android:id="@+id/rl_product_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout

            android:layout_marginTop="@dimen/margin10"
            android:id="@+id/rl_product"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView

                android:id="@+id/img_product"
                android:src="@drawable/prov2"
                android:layout_width="@dimen/image_width"
                android:layout_height="@dimen/image_height"
                />

            <TextView

                android:layout_marginLeft="@dimen/margin10"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:text="cellc"
                android:textStyle="bold"
                android:textSize="@dimen/pad_30dp"
                android:layout_toRightOf="@+id/img_product"
                android:id="@+id/txt_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <TextView
            android:layout_marginBottom="@dimen/margin10"
            android:textSize="@dimen/pad_25dp"
            android:layout_marginTop="@dimen/margin10"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:layout_below="@+id/rl_product"
            android:layout_marginLeft="@dimen/margin10"
            android:textColor="@color/white"
            android:text="Cellc Data  30 MB"
            android:textStyle="bold"
            android:id="@+id/type_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>


    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:textStyle="bold"
        android:textSize="@dimen/pad_25dp"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:layout_below="@+id/rl_product_"
        android:layout_marginLeft="@dimen/margin10"
        android:textColor="@color/white"
        android:text="Amount R5"
        android:visibility="visible"
        android:id="@+id/txt_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"
        android:id="@+id/view_line_1"
        android:layout_below="@+id/txt_amount"
        android:layout_marginTop="@dimen/margin10"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"/>

    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:layout_centerHorizontal="true"
        android:textSize="@dimen/pad_20dp"
        android:gravity="center_horizontal"
        android:layout_below="@+id/view_line_1"
        android:textColor="@color/white"
        android:text="Printing"
        android:layout_marginBottom="@dimen/margin10"
        android:id="@+id/txt_printing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:id="@+id/rl_internet"

        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_below="@+id/txt_printing"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/margin10"
        android:layout_marginTop="@dimen/margin10"
        android:layout_marginEnd="@dimen/margin10"
        android:layout_marginBottom="@dimen/margin10"
        android:background="@color/white"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/txt_internet"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="@dimen/margin10"
            android:gravity="center_horizontal"
            android:text="Internet Connection Issue"
            android:textColor="@color/red"
            android:textSize="@dimen/pad_20dp"
            android:textStyle="bold" />

        <RelativeLayout
            android:id="@+id/rl_network"
            android:layout_width="@dimen/rl_network_width"
            android:layout_height="@dimen/rl_network_height"
            android:layout_below="@+id/txt_internet"
            android:layout_centerHorizontal="true"
            android:background="@drawable/edit_bg_blue"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/img_info"

                android:layout_width="@dimen/pad_20dp"
                android:layout_height="@dimen/pad_20dp"
                android:layout_marginRight="2dp"
                android:layout_centerVertical="true"
                android:src="@drawable/no_wifi" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginRight="2dp"
                android:layout_toRightOf="@+id/img_info"
                android:text="No Internet"
                android:textColor="#fff"
                android:textSize="@dimen/rl_network_text_size" />

        </RelativeLayout>
    </RelativeLayout>



    <TextView
        android:layout_marginTop="@dimen/margin10"
        android:visibility="visible"
        android:textSize="@dimen/pad_15dp"
        android:layout_below="@+id/rl_internet"
        android:layout_marginLeft="@dimen/margin10"
        android:textColor="@color/android_robot"
        android:text="Your voucher is busy printing.\nIf you have an issue, please check Reprint  "
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        android:visibility="visible"

        android:layout_below="@+id/rl_internet"
        android:layout_marginBottom="@dimen/margin10"
        android:layout_alignParentRight="true"
        android:id="@+id/img_reprint"
        android:layout_marginRight="@dimen/margin2.5"
        android:src="@drawable/main_reprint"
        android:layout_width="@dimen/rl_network_reprint_width"
        android:layout_height="@dimen/rl_network_reprint_height"
        />

    <RelativeLayout
        android:layout_below="@+id/img_reprint"
        android:layout_width="match_parent"
        android:layout_height="@dimen/rl_network_reprint_height">
        <TextView
            android:visibility="visible"
            android:layout_marginBottom="@dimen/margin10"
            android:background="@drawable/red_background"
            android:textColor="@color/white"
            android:id="@+id/txt_close"
            android:layout_width="70dp"
            android:textSize="@dimen/pad_15dp"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginLeft="@dimen/margin10"
            android:gravity="center"
            android:layout_height="@dimen/pad_30dp"
            android:text="Close"/>
        <RelativeLayout

            android:background="@color/white"
            android:layout_marginRight="@dimen/margin10"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="@dimen/margin10"
            android:layout_alignParentRight="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_marginRight="@dimen/pad_5dp"
                android:src="@drawable/ic_call_icon"
                android:id="@+id/img_call"
                android:layout_width="@dimen/pad_20dp"
                android:layout_height="@dimen/pad_20dp"/>
            <TextView
                android:layout_toRightOf="@+id/img_call"
                android:textSize="@dimen/pad_15dp"
                android:id="@+id/txt_call"
                android:text="0860 111 723"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <ImageView
                android:layout_below="@+id/txt_call"
                android:layout_marginRight="@dimen/pad_5dp"

                android:src="@drawable/ic_whatsapp"
                android:id="@+id/img_watsapp"
                android:layout_width="@dimen/pad_20dp"
                android:layout_height="@dimen/pad_20dp"/>

            <TextView
                android:textSize="@dimen/pad_15dp"

                android:layout_toRightOf="@+id/img_watsapp"
                android:layout_below="@+id/txt_call"
                android:text="064 121 9970"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
    </RelativeLayout>


</RelativeLayout>