<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"

    android:layout_height="match_parent"
    android:background="@color/white">

    <androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activity_admin">


        <include layout="@layout/layout_tiu_header_new" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scoll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/loginHeader"
            android:background="@color/white"
            android:fillViewport="true"
            android:fitsSystemWindows="true"
            android:focusableInTouchMode="true"
            app:layout_constraintTop_toBottomOf="@+id/tiu_title_bar"
            tools:context=".activity_reprint"
            tools:ignore="MissingConstraints">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/layoutacc"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent"

                    android:layout_marginLeft="5dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginRight="5dp"
                    android:layout_marginBottom="20dp">


                    <TextView
                        android:id="@+id/tv_account_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Number"
                        android:textColor="#3c3c3c"
                        android:textSize="@dimen/pad_15dp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <RelativeLayout
                        android:id="@+id/rel_acc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_account_number"
                        android:orientation="horizontal"
                        android:paddingLeft="5dp"
                        android:paddingRight="5dp">

                        <EditText
                            android:id="@+id/txtAccountNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
                            android:gravity="center_vertical"
                            android:hint="Account Number"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textSize="@dimen/login_invalid_text_size"
                            android:textStyle="bold" />


                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/ll_provider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_response"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" Select Service Provider"
                            android:textColor="#3c3c3c"
                            android:textSize="@dimen/pad_15dp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="80dp"
                            android:layout_below="@+id/rel_acc"
                            android:orientation="horizontal">
                            <ImageButton
                                android:id="@+id/btn_pay"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:padding="10dp"
                                android:background="@null"
                                android:src="@drawable/ic_pay_new"
                                android:scaleType="centerInside"
                                android:contentDescription="Pay" />

                          <!--  <Button
                                android:id="@+id/btn_pay"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:padding="10dp"
                                android:background="@drawable/ic_pay_new"
                                android:textAllCaps="false"></Button>-->

                            <Button
                                android:id="@+id/btn_easy_pay"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/btn_white_curved"
                                android:text="EasyPay"
                                android:textAllCaps="false">
                                <!-- Content for the first part goes here -->
                            </Button>

                            <!-- Third part -->
                            <Button
                                android:id="@+id/btn_syntel"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_margin="5dp"
                                android:layout_weight="1"
                                android:background="@drawable/btn_white_curved"
                                android:text="Syntell"
                                android:textAllCaps="false">
                                <!-- Content for the first part goes here -->
                            </Button>

                        </LinearLayout>

                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/rl_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rel_acc"
                        android:layout_marginBottom="10dp"
                        android:background="@color/grey_40"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/pad_20dp"
                            android:layout_marginTop="@dimen/pad_20dp"
                            android:layout_marginRight="@dimen/pad_20dp"
                            android:layout_marginBottom="@dimen/pad_20dp"

                            android:background="@color/white"
                            android:orientation="vertical"
                            tools:ignore="MissingConstraints">

                            <TextView
                                android:id="@+id/tv_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/pad_5dp"
                                android:text="Amount"
                                android:textColor="#3c3c3c"
                                android:textSize="@dimen/pad_15dp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/dialog_input_size"
                                android:layout_marginLeft="@dimen/margin10"
                                android:layout_marginTop="@dimen/margin10"
                                android:layout_marginRight="@dimen/margin10"
                                android:layout_marginBottom="@dimen/pad_5dp"
                                android:weightSum="2">

                                <TextView

                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/dialog_input_size"
                                    android:layout_marginRight="@dimen/margin10"
                                    android:layout_weight="1"
                                    android:background="@drawable/gray_blue"
                                    android:gravity="center"
                                    android:text="Rands"
                                    android:textColor="@color/black"
                                    android:textSize="22dp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/dialog_input_size"
                                    android:layout_marginLeft="@dimen/margin10"
                                    android:layout_weight="1"
                                    android:background="@drawable/gray_blue"
                                    android:gravity="center"
                                    android:text="Cents"
                                    android:textColor="@color/black"
                                    android:textSize="22dp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/pad_50dp"

                                android:layout_marginLeft="@dimen/margin10"
                                android:layout_marginRight="@dimen/margin10"
                                android:weightSum="2">

                                <EditText
                                    android:id="@+id/dialogEditText"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/pad_50dp"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.95"
                                    android:background="@drawable/textbox_border"
                                    android:cursorVisible="true"
                                    android:gravity="center"
                                    android:hint=" R 0 "
                                    android:imeOptions="actionNext"
                                    android:inputType="number"
                                    android:maxLength="8"
                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="28sp" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/pad_50dp"
                                    android:layout_weight="0.1"
                                    android:gravity="center"
                                    android:text="."
                                    android:textColor="@color/black"
                                    android:textSize="35dp" />

                                <EditText
                                    android:id="@+id/dialogEditText_cent"

                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/pad_50dp"
                                    android:layout_gravity="center"
                                    android:layout_weight="0.95"
                                    android:background="@drawable/textbox_border"
                                    android:cursorVisible="true"
                                    android:gravity="center"
                                    android:hint=" 00 "
                                    android:imeOptions="actionDone"
                                    android:inputType="number"
                                    android:maxLength="2"

                                    android:textColor="@color/black"
                                    android:textColorHint="@color/black"
                                    android:textSize="28sp" />


                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="left"
                                android:layout_marginLeft="@dimen/margin10">

                                <TextView
                                    android:id="@+id/txt_rand"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/pad_10dp"
                                    android:text=""
                                    android:textColor="@color/red"
                                    android:textSize="@dimen/pad_20dp" />

                                <TextView
                                    android:id="@+id/txt_cent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginLeft="@dimen/margin10"
                                    android:text="one  tweenty cennt"
                                    android:textColor="@color/red"
                                    android:textSize="@dimen/pad_15dp"
                                    android:visibility="gone" />

                            </LinearLayout>
                        </LinearLayout>

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rl_buttons"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rl_amount"
                        android:gravity="center_horizontal">

                        <Button
                            android:id="@+id/btn_clear"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginRight="5dp"
                            android:background="@drawable/btn_orange_curved"
                            android:padding="10dp"
                            android:text="Clear"
                            android:textAllCaps="false" />

                        <Button
                            android:id="@+id/btn_nexts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="right"
                            android:layout_marginRight="5dp"
                            android:layout_toRightOf="@+id/btn_clear"
                            android:background="@drawable/btn_green_curved"
                            android:padding="10dp"
                            android:text="Next"
                            android:textAllCaps="false" />
                    </RelativeLayout>

                    <!-- <TextView
                         android:id="@+id/tv_value"
                         android:layout_width="wrap_content"
                         android:layout_height="wrap_content"
                         android:layout_below="@+id/txtAccountNumber"
                         android:layout_marginTop="10dp"
                         android:text="Amount"
                         android:textColor="#3c3c3c"
                         android:textSize="15sp"
                         android:textStyle="bold" />-->

                    <EditText
                        android:id="@+id/txtPaymentAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ems="10"
                        android:hint="0.00"
                        android:inputType="numberDecimal"
                        android:textSize="@dimen/login_invalid_text_size"
                        android:visibility="gone" />


                    <RadioGroup
                        android:id="@+id/tendertype"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rl_amount"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/radio_cash"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="Cash"
                            android:textSize="@dimen/pad_15dp" />

                        <RadioButton
                            android:id="@+id/radio_credit"

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Credit Card"
                            android:textSize="@dimen/pad_15dp" />


                        <RadioButton
                            android:id="@+id/radio_debit"

                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Debit Card"
                            android:textSize="@dimen/pad_15dp" />
                    </RadioGroup>


                    <Button
                        android:id="@+id/btn_next"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rl_buttons"
                        android:layout_marginTop="5dp"
                        android:padding="20dp"
                        android:text="Next"
                        android:textSize="18dp"
                        android:visibility="gone" />


                    <TextView
                        android:id="@+id/tv_response"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/btn_next"
                        android:layout_margin="5dp"
                        android:gravity="center"
                        android:text=""
                        android:textSize="16dp" />


                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/payment_recycler_height"
                    android:layout_gravity="bottom"
                    android:layout_marginBottom="5dp"
                    android:scrollbars="horizontal" />

                <Button
                    android:id="@+id/btn_lookup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginStart="85dp"
                    android:layout_marginBottom="40dp"
                    android:padding="26dp"
                    android:text="Bill Issuer Lookup"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    >


    <com.google.android.material.bottomnavigation.BottomNavigationView

        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorPrimary"
        app:itemBackground="@drawable/bottom_navigation_back_colors"
        app:itemIconSize="@dimen/pad_25dp"

        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_back" />


</FrameLayout>