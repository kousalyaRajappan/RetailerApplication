<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"

    tools:context=".admin.activity_users_detail">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/AppTheme.AppBarOverlay">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:popupTheme="@style/AppTheme.PopupOverlay" />

    </com.google.android.material.appbar.AppBarLayout>



    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginLeft="@dimen/pad_20dp"
        android:layout_marginTop="@dimen/login_dialog_dark_loading_hight"
        android:layout_marginRight="@dimen/pad_20dp"
        android:layout_marginBottom="@dimen/pad_20dp">


        <WebView
            android:id="@+id/wv_credit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/temp_credit_height"
             />




        <EditText
            android:layout_below="@+id/wv_credit"
            android:layout_marginTop="@dimen/pad_15dp"
            android:id="@+id/txt_otp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:maxLength="4"
            android:textSize="@dimen/pad_15dp"
            android:hint="Enter OTP"
            android:inputType="number" />

        <Button
            android:layout_below="@+id/txt_otp"
            android:id="@+id/btn_process"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:padding="@dimen/pad_20dp"
            android:text="Process" />

        <EditText
            android:layout_below="@+id/wv_credit"

            android:layout_marginTop="@dimen/pad_15dp"
            android:id="@+id/txt_request_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ems="10"
            android:hint="0.00"
            android:textSize="@dimen/pad_15dp"
            android:inputType="numberDecimal" />

        <Button
            android:layout_below="@+id/txt_request_amount"

            android:id="@+id/btn_request"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pad_20dp"
            android:textSize="@dimen/pad_15dp"
            android:padding="@dimen/pad_20dp"
            android:text="Request" />



        <Button
            android:id="@+id/btn_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/wv_credit"
            android:layout_marginTop="@dimen/pad_50dp"
            android:padding="@dimen/pad_20dp"
            android:textSize="@dimen/pad_15dp"
            android:text="Exit" />



    </RelativeLayout>





</androidx.coordinatorlayout.widget.CoordinatorLayout>