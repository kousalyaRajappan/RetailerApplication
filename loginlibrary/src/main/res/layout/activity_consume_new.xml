    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:background="#C7C6C1"
        android:layout_marginTop="@dimen/pad_40dp"
        android:id="@+id/relpayscreen"
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin20">

        <WebView
            android:id="@+id/wb_slip"
            android:elevation="10dp"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/pad_15dp"
            android:layout_marginLeft="@dimen/pad_15dp"
            android:layout_marginRight="@dimen/pad_15dp"
            android:background="@drawable/btn_rounded_red"
            android:layout_height="@dimen/adpay_reprint_bottom" />

        <androidx.cardview.widget.CardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="@dimen/consume_cardview_height"
            card_view:cardUseCompatPadding="true"
            android:layout_marginTop="@dimen/margin10"
            android:background="#e5e5e5"
            android:layout_marginLeft="-5dp"
            android:layout_marginRight="-5dp"
            android:layout_below="@+id/wb_slip"
            card_view:cardElevation="@dimen/margin10">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/consume_cardview_h"
            android:orientation="vertical"
            android:background="#e5e5e5"
            >
            <TextView
                android:id="@+id/tv_print_slip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin10"
                android:fontFamily="sans-serif-black"
                android:layout_gravity="center"
                android:text="Print Slip(s)"
                android:textColor="@color/black"
                android:textSize="@dimen/margin20"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.5"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/wv_slip" />


            <View
                android:id="@+id/view"
                android:layout_marginStart="@dimen/pad_15dp"
                android:layout_width="@dimen/consume_300dp"
                android:layout_height="@dimen/view_2"
                android:layout_marginTop="@dimen/pad_15dp"
                android:background="@color/red"
                android:layout_below="@+id/tv_print_slip"
               />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:background="#e5e5e5"
            android:layout_marginTop="@dimen/pad_10dp"
            android:layout_marginStart="@dimen/pad_5dp"
            android:layout_marginRight="@dimen/pad_5dp"
            android:layout_below="@+id/view"
            >
        <Button
            android:id="@+id/btn_merchant"
            android:layout_width="@dimen/transfer_card_heigth"
            android:layout_height="@dimen/tab_multi_height"
            android:layout_alignParentBottom="true"
            android:background="@drawable/button_border"
            android:fontFamily="sans-serif-black"
            android:layout_alignParentLeft="true"
            android:text="\nMerchant\n"
            android:onClick="onNumClick"
            android:textAllCaps="false"

            android:textColor="@drawable/text_state_color"
            android:textSize="@dimen/txt_16sp"
    />
            <Button
                android:id="@+id/btn_customer"
               android:layout_marginStart="12dp"
                android:layout_width="@dimen/transfer_card_heigth"
                android:layout_height="@dimen/tab_multi_height"
                android:layout_centerHorizontal="true"
                android:background="@drawable/button_border"
                android:fontFamily="sans-serif-black"
                android:text="\nCustomer\n"
                android:textAllCaps="false"
                android:onClick="onNumClick"
                android:textColor="@drawable/text_state_color"
                android:textSize="@dimen/txt_16sp"
                />
            <Button
                android:id="@+id/btn_merchant_customer"
                android:layout_width="@dimen/transfer_card_heigth"
                android:layout_height="@dimen/tab_multi_height"
                android:layout_marginStart="12dp"
                android:textAllCaps="false"
                android:layout_alignParentRight="true"
                android:background="@drawable/button_border"
                android:fontFamily="sans-serif-black"
                android:layout_weight="1"
                android:onClick="onNumClick"
                android:text="Merchant\n&amp;\nCustomer"
                android:textColor="@drawable/text_state_color"
                android:textSize="@dimen/txt_16sp"
                />    </LinearLayout>

        </LinearLayout>
        </androidx.cardview.widget.CardView>
    </RelativeLayout>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        app:itemBackground="@drawable/bottom_navigation_back_colors"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:elevation="8dp"
        app:itemIconSize="@dimen/pad_25dp"

        android:background="@color/colorPrimary"
        app:menu="@menu/bottom_navigation_swipecard" />


