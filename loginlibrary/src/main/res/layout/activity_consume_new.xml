                android:layout_width="0dp"
                android:layout_height="match_parent"/>


            <Button
                android:id="@+id/btn_consume"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:background="@drawable/button_res_three"
                android:fontFamily="sans-serif-black"
