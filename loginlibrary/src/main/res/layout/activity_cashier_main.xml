<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"

    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activity_admin">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/pad_50dp"
            android:background="@color/colorPrimary"
            android:theme="@style/AppTheme.AppBarOverlay">

            <RelativeLayout
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">

                <customfonts.MyTextView_Montserrat_Medium
                    android:id="@+id/textViewheader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8.3dp"
                    android:layout_marginTop="@dimen/spi_item_text_size_14dp"
                    android:text="Reports"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/pad_18dp" />

            </RelativeLayout>

            <customfonts.MyTextView_Montserrat_Medium
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="8.3dp"
                android:layout_marginTop="10dp"
                android:text="Reports"
                android:textColor="@android:color/white"
                android:textSize="@dimen/pad_18dp" />

            <customfonts.MyTextView_Montserrat_Medium
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignBaseline="@id/textViewheader"
                android:layout_gravity="center"
                android:layout_marginStart="25dp"
                android:layout_marginTop="@dimen/margin10"
                android:text="Back"
                android:textColor="@android:color/white"
                android:textSize="@dimen/pad_18dp" />

        </com.google.android.material.appbar.AppBarLayout>

        <include layout="@layout/content_main_admin" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="0dp"
        android:background="@color/colorPrimary"
        app:itemIconSize="@dimen/pad_25dp"

        app:elevation="8dp"
        app:itemBackground="@drawable/bottom_navigation_back_colors"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_admin_back" />
</FrameLayout>