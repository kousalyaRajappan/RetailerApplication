<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"

    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <include layout="@layout/layout_tiu_header_new" />

    <RelativeLayout
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_marginTop="@dimen/loginHeader"
        android:layout_marginBottom="20dp">

        <RelativeLayout
            android:layout_marginTop="20dp"
            android:id="@+id/rl_acc_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp">


            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/meter_input"
                app:boxStrokeColor="@color/black"
                android:textColorHint="@color/black"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                app:hintTextAppearance="@style/TextLabel"
                android:hint="Meter Number">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    android:id="@+id/txtAccountNumber"
                    android:textSize="21dp"
                    android:padding="10dp"
                    android:inputType="textImeMultiLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </com.google.android.material.textfield.TextInputLayout>
            <TextView
                android:visibility="gone"
                android:layout_below="@+id/meter_input"
                android:id="@+id/tv_account_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meter Number"
                android:textColor="#3c3c3c"
                android:textSize="@dimen/pad_15dp"
                android:textStyle="bold" />

            <EditText
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_account_number"
                android:ems="10"
                android:inputType="textImeMultiLine"
                android:textSize="@dimen/pad_15dp"

                android:imeOptions="actionDone"
                android:hint="Meter Number"
                android:text="" />
        </RelativeLayout>


        <LinearLayout
            android:visibility="gone"

            android:id="@+id/ll_amount_wrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rl_acc_number"
            android:orientation="vertical">


            <RelativeLayout
                app:layout_constraintTop_toBottomOf="@+id/grp_radio_layout_to"

                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:layout_marginLeft="@dimen/pad_20dp"
                    android:layout_marginRight="@dimen/pad_20dp"

                    android:orientation="vertical"
                    tools:ignore="MissingConstraints">
                    <TextView
                        android:id="@+id/tv_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Amount"
                        android:layout_marginLeft="@dimen/pad_5dp"
                        android:textColor="#3c3c3c"
                        android:textSize="@dimen/pad_15dp"
                        android:textStyle="bold" />
                    <LinearLayout
                        android:weightSum="2.1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/blue"

                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:hint="Rands">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dialogEditText"
                                android:inputType="number"

                                android:maxLength="8"
                                android:textColor="@color/black"
                                android:text=""
                                android:textSize="17dp"
                                android:padding="10dp"
                                android:imeOptions="actionDone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </com.google.android.material.textfield.TextInputLayout>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="0.1"
                            android:gravity="center"
                            android:text="."
                            android:textColor="@color/black"
                            android:textSize="35dp" />
                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            app:boxStrokeColor="@color/blue"

                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:hint="Cents">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/dialogEditText_cent"
                                android:inputType="number"
                                android:maxLength="2"
                                android:textColor="@color/black"
                                android:textColorHint="@color/black"
                                android:textSize="17dp"
                                android:padding="10dp"
                                android:imeOptions="actionDone"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                        </com.google.android.material.textfield.TextInputLayout>

                    </LinearLayout>


                    <LinearLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/electricity_rand_view_height"
                        android:layout_marginLeft="@dimen/margin10"
                        android:layout_marginTop="@dimen/margin10"
                        android:layout_marginRight="@dimen/margin10"
                        android:layout_marginBottom="@dimen/pad_5dp"
                        android:weightSum="2">

                        <TextView

                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginRight="@dimen/margin10"
                            android:layout_weight="1"
                            android:background="@drawable/gray_blue"
                            android:gravity="center"
                            android:text="Rands"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginLeft="@dimen/margin10"
                            android:layout_weight="1"
                            android:background="@drawable/gray_blue"
                            android:gravity="center"

                            android:text="Cents"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"

                        android:layout_marginLeft="@dimen/margin10"
                        android:layout_marginRight="@dimen/margin10"
                        android:weightSum="2">

                        <EditText
                            android:layout_width="0dp"
                            android:layout_height="@dimen/pad_40dp"
                            android:layout_gravity="center"
                            android:layout_weight="0.95"
                            android:background="@drawable/textbox_border"
                            android:cursorVisible="true"
                            android:gravity="center"
                            android:hint=" R 0 "
                            android:inputType="number"
                            android:maxLength="8"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="25sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="0.1"
                            android:gravity="center"
                            android:text="."
                            android:textColor="@color/black"
                            android:textSize="35dp" />

                        <EditText

                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:layout_weight="0.95"
                            android:background="@drawable/textbox_border"
                            android:cursorVisible="true"
                            android:gravity="center"
                            android:hint=" 00 "
                            android:inputType="number"
                            android:maxLength="2"
                            android:textColor="@color/black"
                            android:textColorHint="@color/black"
                            android:textSize="25sp" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="left"
                        android:layout_marginLeft="@dimen/margin10">

                        <TextView
                            android:id="@+id/txt_rand"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text=""
                            android:textColor="@color/red"
                            android:textSize="13dp" />

                        <TextView
                            android:id="@+id/txt_cent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/margin10"
                            android:text="one  tweenty cennt"
                            android:textColor="@color/red"
                            android:textSize="@dimen/pad_15dp"
                            android:visibility="gone" />

                    </LinearLayout>
                </LinearLayout>

            </RelativeLayout>



            <EditText
                android:id="@+id/txtPaymentAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ems="10"
                android:hint="0.00"
                android:textSize="@dimen/pad_15dp"
                android:inputType="numberDecimal"
                android:visibility="gone" />

            <LinearLayout
                android:gravity="center"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:orientation="horizontal">

                <Button
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:onClick="decreaseInteger"
                    android:text="-" />

                <TextView
                    android:id="@+id/voucher_qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="10dp"
                    android:layout_marginLeft="10dp"
                    android:text="1"
                    android:textSize="@dimen/pad_40dp"
                    android:textStyle="bold" />

                <Button
                    android:layout_width="45dp"
                    android:layout_height="40dp"
                    android:onClick="increaseInteger"
                    android:text="+" />
            </LinearLayout>

        </LinearLayout>


        <RelativeLayout
            android:layout_marginTop="@dimen/margin10"
            android:layout_below="@+id/ll_amount_wrapper"

            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/btn_lyt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_toRightOf="@+id/freetoken"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:background="@drawable/btn_orange_curved"
                    android:padding="10dp"
                    android:text="Clear"
                    android:textAllCaps="false" />
                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="right"
                    android:layout_marginRight="5dp"
                    android:layout_toRightOf="@+id/btn_clear"
                    android:background="@drawable/btn_green_curved"
                    android:padding="10dp"
                    android:text="Next"
                    android:textAllCaps="false" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_response"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btn_lyt"
                android:gravity="center"
                android:padding="@dimen/pad_25dp"
                android:text="" />

            <TextView
                android:id="@+id/tv_notice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btn_lyt"
                android:textSize="@dimen/pad_15dp"
                android:text=" Please ensure that all staff are trained &amp; comply with Municipality policies for vending Electricity:\n
\n1. Can not overcharge for tokens
\n2. No minumum vending amount
\n3. Must vend Free Tokens Failure to comply will result in the Municipality deactivating Electricity vending permanently
\n\nDue to security reasons we are unable to refund vouchers." />

            <com.makeramen.roundedimageview.RoundedImageView
                android:id="@+id/prov_12"
                android:layout_width="@dimen/multi_voucher_img"
                android:layout_height="@dimen/multi_voucher_img"
                android:layout_below="@+id/tv_notice"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_marginTop="-1dp"
                android:layout_weight="1"
                android:onClick="onclick_btn_provider"
                android:src="@drawable/prov12_small"
                android:tag="prov_unipin"
                android:visibility="gone" />


            <Button
                android:id="@+id/freetoken"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_alignParentLeft="true"
                android:textSize="@dimen/pad_15dp"
                android:background="@drawable/gray_back"

                android:padding="@dimen/pad_5dp"

                android:onClick="getfreetokens"
                android:text="Get Free Tokens"
                android:textAllCaps="false"
                android:visibility="gone" />
        </RelativeLayout>



    </RelativeLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/colorPrimary"
        app:itemBackground="@drawable/bottom_navigation_back_colors"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="@dimen/pad_25dp"

        app:menu="@menu/bottom_navigation_back">

    </com.google.android.material.bottomnavigation.BottomNavigationView>


</FrameLayout>