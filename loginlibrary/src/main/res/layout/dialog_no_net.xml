<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="@dimen/pad_15dp"
    android:layout_marginLeft="@dimen/pad_15dp"
    android:background="@color/black">


    <LinearLayout
        android:padding="@dimen/pad_15dp"
        android:id="@+id/ll_head"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="23 jan 2023"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />

            <TextView
                android:id="@+id/txt_account"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:maxLines="1"
                android:layout_marginTop="5dp"
                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <View
                android:visibility="gone"
                android:layout_below="@+id/txt_clock"

                android:layout_centerVertical="true"
                android:id="@+id/view2"
                android:layout_toRightOf="@+id/txt_account"
                android:layout_width="2dp"
                android:layout_height="10dp"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:id="@+id/txt_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_toRightOf="@+id/view2"
                android:maxLines="1"
                android:layout_marginTop="5dp"

                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />
            <TextView


                android:layout_alignParentRight="true"
                android:id="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="visible"
                android:text="2.3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/headtextSize" />

            <TextView
                android:layout_marginTop="5dp"

                android:layout_toLeftOf="@+id/view1"
                android:id="@+id/txt_user_name"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="username"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
            <View
                android:id="@+id/view1"
                android:layout_below="@+id/txt_app_version"

                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/txt_acc_type"
                android:layout_width="2dp"
                android:layout_height="10dp"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>
            <TextView
                android:layout_marginTop="5dp"

                android:layout_alignParentRight="true"
                android:id="@+id/txt_acc_type"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="Admin"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
        </RelativeLayout>


    </LinearLayout>

    <View

        android:id="@+id/view_line"
        android:layout_below="@+id/ll_head"
        android:layout_marginTop="@dimen/margin10"
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"

        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>





    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:layout_centerHorizontal="true"
        android:textSize="@dimen/pad_20dp"
        android:gravity="center_horizontal"
        android:textColor="@color/yellow"
        android:text="Internet Connection Issue"
        android:layout_below="@+id/view_line"
        android:layout_marginBottom="@dimen/margin10"
        android:id="@+id/txt_internet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <RelativeLayout
        android:id="@+id/rl_network"

        android:layout_centerHorizontal="true"
        android:layout_below="@+id/txt_internet"
        android:background="@drawable/edit_bg_blue"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/pad_50dp">
        <ImageView
            android:layout_centerVertical="true"

            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp"
            android:id="@+id/img_info"
            android:src="@drawable/no_wifi"
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="@dimen/pad_20dp"/>
        <TextView
            android:layout_toRightOf="@+id/img_info"
            android:id="@+id/no_internet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="No Internet"
            android:layout_marginRight="2dp"
            android:textSize="@dimen/pad_15dp"
            android:textColor="#fff" />

    </RelativeLayout>

    <TextView
        android:layout_marginLeft="@dimen/pad_10dp"
        android:visibility="visible"
        android:layout_marginBottom="@dimen/margin10"
        android:background="@drawable/red_background"
        android:layout_below="@+id/rl_network"
        android:textColor="@color/white"
        android:id="@+id/txt_close"
        android:layout_width="70dp"
        android:layout_marginTop="10dp"
        android:textSize="@dimen/pad_15dp"
        android:gravity="center"
        android:layout_height="@dimen/pad_30dp"
        android:text="Close"/>

    <RelativeLayout
        android:id="@+id/btn_show_more_contact"
        android:layout_below="@+id/rl_network"

        android:background="@color/white"
        android:layout_marginRight="@dimen/margin10"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="@dimen/margin10"
        android:layout_alignParentRight="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginRight="@dimen/pad_5dp"
            android:src="@drawable/ic_call_icon"
            android:id="@+id/img_call"
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="@dimen/pad_20dp"/>
        <TextView
            android:layout_toRightOf="@+id/img_call"
            android:textSize="@dimen/pad_15dp"
            android:id="@+id/txt_call"
            android:text="0860 111 723"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_below="@+id/txt_call"
            android:layout_marginRight="@dimen/pad_5dp"

            android:src="@drawable/ic_whatsapp"
            android:id="@+id/img_watsapp"
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="@dimen/pad_20dp"/>

        <TextView
            android:textSize="@dimen/pad_15dp"

            android:layout_toRightOf="@+id/img_watsapp"
            android:layout_below="@+id/txt_call"
            android:text="064 121 9970"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>



</RelativeLayout>