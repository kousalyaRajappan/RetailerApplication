<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"

    android:orientation="vertical">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grey_40"
        android:gravity="center"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/pop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Out Of Paper"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="@android:color/black"
            android:textSize="@dimen/pad_20dp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="70dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/pad_5dp"
            android:src="@drawable/out_of_paper"
            android:visibility="visible" />

        <TextView
            android:id="@+id/pop_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="10dp"
            android:text="Please check paper and try again"
            android:textAlignment="center"
            android:textSize="@dimen/pad_20dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Subhead"
            android:textColor="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:visibility="gone">


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_paper_load"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:layout_marginLeft="85dp"
                android:layout_marginTop="@dimen/spacing_large"
                android:background="@drawable/btn_rounded_white"
                android:text="  Paper Loaded            "
                android:textColor="@color/black"
                android:textSize="10sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_Paper_ignore_time"
                android:layout_width="120dp"
                android:layout_height="80dp"
                android:background="@drawable/btn_rounded_white"
                android:text="Ignore Out\nof Paper this\ntime Only"
                android:textColor="@color/black"
                android:textSize="10sp" />


            <!--   <androidx.appcompat.widget.AppCompatButton
                  android:id="@+id/btn_Paper_ignore_always"
                  android:layout_width="95dp"
                   android:layout_height="80dp"
                   android:background="@drawable/btn_rounded_white"
                   android:text="Ignore Out\nof Paper\nAlways"
                   android:textSize="10sp"
                   android:textColor="@color/black"/>

                      <androidx.appcompat.widget.AppCompatButton
                         android:id="@+id/btn_Paper_ignore_al"
                         style="@style/Widget.AppCompat.Button.Borderless"
