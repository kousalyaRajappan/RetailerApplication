<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        layout="@layout/layout_tiu_header_new" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioGroup
            android:id="@+id/grp_radio_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/loginHeader"
            android:orientation="horizontal"
            android:padding="@dimen/pad_15dp"
            app:layout_constraintTop_toTopOf="parent">



                <RadioButton
                    android:id="@+id/rdo_filter_type_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Admin and Cashier"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioButton
                    android:id="@+id/rdo_filter_type_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Cashier Only"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/rdo_filter_type_0"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioButton
                    android:id="@+id/rdo_filter_type_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="Bill Payments"
                    android:textSize="12dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/rdo_filter_type_1"
                    app:layout_constraintTop_toTopOf="parent" />






        </RadioGroup>


        <RadioGroup
            android:layout_below="@+id/grp_radio_layout"
            android:id="@+id/grp_radio_product"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/pad_15dp"
            app:layout_constraintTop_toBottomOf="@+id/grp_radio_layout">



                <RadioButton
                    android:id="@+id/rdo_filter_product_0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="By Products"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <RadioButton
                    android:id="@+id/rdo_filter_product_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="46dp"
                    android:text="By Denominations"
                    android:textSize="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/rdo_filter_product_0"
                    app:layout_constraintTop_toTopOf="parent" />







        </RadioGroup>



        <EditText
            android:id="@+id/txt_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin20"
            android:layout_marginLeft="@dimen/pad_15dp"
            android:layout_marginRight="@dimen/pad_15dp"
            android:ems="10"
            android:hint="Serial Number / UID"
            android:visibility="gone"
            android:inputType="text"
            android:textSize="@dimen/pad_15dp"
            android:layout_below="@+id/grp_radio_product" />

        <TextView
            android:layout_marginTop="@dimen/pad_20dp"
            android:id="@+id/tv_mess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pad_25dp"
            android:text="Uncheck Product to Disable"
            android:textColor="#3c3c3c"
            android:textSize="@dimen/pad_15dp"
            android:textStyle="bold"

            android:layout_below="@+id/grp_radio_product"
            />

            <com.za.toptitup.loginlibrary.utils.MultiSelectionSpinner
                android:layout_below="@+id/tv_mess"
                android:id="@+id/spinnerproduct"
                android:layout_width="@dimen/product_setting_multi_spinner"
                android:layout_marginTop="8dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pad_15dp"
                android:background="@drawable/spinner_background"
                app:layout_constraintBottom_toBottomOf="@+id/txt_input" />

        <Button
            android:id="@+id/btn_bottom_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:layout_alignParentBottom="true"
            android:onClick="onclick_btn_action"
            android:visibility="gone"
            android:textSize="@dimen/pad_15dp"
            android:text="Close" />

        <Button
            android:id="@+id/btn_bottom_reprint_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_weight="1"
            android:visibility="gone"
            android:textSize="@dimen/pad_15dp"
            android:onClick="onclick_btn_action"
            android:text="Reprint Last" />
    </LinearLayout>


    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:labelVisibilityMode="labeled"
        android:background="@color/colorPrimary"
        app:itemIconSize="@dimen/pad_25dp"

        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:menu="@menu/bottom_navigation_admin_menu" />


</FrameLayout>