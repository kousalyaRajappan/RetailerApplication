<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:layout_marginRight="@dimen/pad_15dp"
    android:layout_marginLeft="@dimen/pad_15dp"
    android:padding="@dimen/pad_15dp"
    android:background="@color/gray_light">
    <RelativeLayout
        android:gravity="center"
        android:id="@+id/lo_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin10"
        android:visibility="visible"
        android:padding="@dimen/pad_5dp">

        <TextView
            android:layout_centerHorizontal="true"
            android:id="@+id/tv_dis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin10"
            android:fontFamily="sans-serif-medium"
            android:text="Add Discount"
            android:textColor="@color/black"
            android:textSize="@dimen/pad_25dp" />

        <TextView
            android:visibility="gone"
            android:id="@+id/tv_clear_tip"
            android:layout_width="@dimen/pad_50dp"
            android:layout_height="50dp"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginRight="@dimen/pad_50dp"
            android:layout_toRightOf="@id/tv_dis"
            android:background="@drawable/button_border_six"
            android:gravity="center"
            android:onClick="onNumClick"
            android:text="C"
            android:textColor="@drawable/state_color_two" />

        <!--    <EditText
                android:id="@+id/txt_perc_tip"
                android:layout_width="50dp"
                android:layout_height="30dp"
                android:layout_toRightOf="@+id/tv_clear_tip"
                android:background="@drawable/textbox_border"
                android:cursorVisible="true"
                android:hint=" % "
                android:gravity="right"
                android:inputType="numberDecimal"
                android:maxLength="5"
                android:padding="3dp"

                android:textColor="@color/black"
                android:textColorHint="@color/black" />-->

        <EditText
            android:layout_centerHorizontal="true"
            android:id="@+id/txt_rand_disc_dia"
            android:layout_width="@dimen/spi_item_height"
            android:layout_height="@dimen/pad_50dp"
            android:layout_marginTop="@dimen/margin10"
            android:layout_below="@+id/tv_dis"
            android:background="@drawable/textbox_border"
            android:cursorVisible="true"
            android:hint=" R 0.00 "
            android:inputType="numberDecimal"
            android:gravity="right|center"
            android:maxLength="8"
            android:padding="3dp"

            android:textColor="@color/black"
            android:textColorHint="@color/black" />

        <TextView
            android:id="@+id/txt_ok"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:layout_marginTop="@dimen/pad_15dp"
            android:textColor="@color/white"
            android:background="@drawable/btn_rounded_green"
            android:layout_below="@+id/txt_rand_disc_dia"
            android:text="Proceed"
            android:textSize="@dimen/pad_15dp"
            android:layout_width="@dimen/spi_item_height"
            android:layout_height="@dimen/pad_50dp"/>
    </RelativeLayout>



</RelativeLayout>