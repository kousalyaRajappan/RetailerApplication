<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/white"

    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".activity_admin">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/loginHeader">

            <include layout="@layout/layout_tiu_header_new" />
        </com.google.android.material.appbar.AppBarLayout>

        <include layout="@layout/content_main" />


    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:itemBackground="@drawable/bottom_navigation_back_colors"
        app:itemIconTint="@drawable/bottom_navigation_colors"
        app:itemTextColor="@drawable/bottom_navigation_colors"
        app:menu="@menu/bottom_navigation_menu" />

    <RelativeLayout

        android:layout_width="match_parent"
        android:layout_height="@dimen/main_bottom_size"
        android:layout_gravity="bottom"
        android:background="@color/colorPrimary"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/ll_main_bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorPrimary"
            android:orientation="horizontal"
            android:visibility="visible"
            android:weightSum="3">

            <LinearLayout
                android:id="@+id/ll_logout"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView


                    android:id="@+id/img_logout"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/main_logout"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/img_logout_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_admin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_admin"

                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/key_variant" />

                <TextView
                    android:id="@+id/img_admin_txt"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Admin"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_cash_drawer"
                android:layout_width="0dp"
                android:visibility="gone"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView


                    android:id="@+id/img_cash"
                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/cashier_tab_white"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:id="@+id/img_cash_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open Cash Drawer"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_reprint"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/img_reprint"

                    android:layout_width="@dimen/bottom_icon_size"
                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/main_reprint" />

                <TextView
                    android:id="@+id/img_reprint_txt"

                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reprint"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_back"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:background="@color/colorPrimary"
            android:visibility="visible">

            <LinearLayout
                android:layout_marginTop="5dp"
                android:id="@+id/ll_logoutRing"
                android:layout_width="100dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:background="@color/colorPrimary"
                android:orientation="vertical">

                <ImageView

                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/main_logout"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="Logout"
                    android:textColor="@color/white"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="100dp"
                android:layout_height="@dimen/pad_50dp"
                android:layout_gravity="center"
                android:background="@color/white"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView

                    android:layout_width="@dimen/bottom_icon_size"

                    android:layout_height="@dimen/bottom_icon_size"
                    android:src="@drawable/arrow_back"
                    android:tint="@color/colorPrimary"
                    tools:ignore="UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Back"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/main_bottom_icon_text_size" />
            </LinearLayout>


        </LinearLayout>

    </RelativeLayout>

</FrameLayout>