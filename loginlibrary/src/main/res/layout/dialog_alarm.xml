<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/login_add_dialog_hight"

    android:background="@android:color/transparent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

<RelativeLayout
    android:gravity="center"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="@dimen/pad_20dp"
        android:id="@+id/img"
        android:layout_width="match_parent"
        android:layout_height="@dimen/login_add_dialog"
        android:src="@drawable/img_load"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />


    <TextView

        android:layout_centerHorizontal="true"
        android:id="@+id/txt_read"
        android:layout_width="@dimen/dialog_alarm_text_width"
        android:layout_height="@dimen/dialog_alarm_text_height"
        android:layout_marginTop="@dimen/margin10"
        android:background="@drawable/btn_rounded_green"
        android:text="I READ"
        android:textSize="@dimen/dialog_alarm_text_size"

        android:textColor="@color/white"
        android:gravity="center"
        android:layout_below="@+id/img"
        tools:ignore="MissingConstraints,UnknownId" />
</RelativeLayout>


</RelativeLayout>