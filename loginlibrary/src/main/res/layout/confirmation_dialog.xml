<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/black"

    android:orientation="vertical">


    <LinearLayout
        android:id="@+id/ll_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin10">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_weight="1"
                android:text="23 jan 2023"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <TextView
                android:id="@+id/txt_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_marginTop="5dp"
                android:maxLines="1"
                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize"
                android:visibility="gone" />

            <View
                android:id="@+id/view2"
                android:layout_width="@dimen/view_2"

                android:layout_height="@dimen/headerViewHeight"
                android:layout_below="@+id/txt_clock"
                android:layout_centerVertical="true"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="9dp"
                android:layout_toRightOf="@+id/txt_account"
                android:background="#FFFF00"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txt_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_marginTop="5dp"
                android:layout_toRightOf="@+id/view2"
                android:maxLines="1"

                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <TextView


                android:id="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:layout_weight="1"
                android:text="2.3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/headtextSize"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txt_user_name"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_app_version"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/pad_5dp"
                android:layout_toLeftOf="@+id/view1"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="username"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <View
                android:id="@+id/view1"
                android:layout_width="@dimen/view_2"

                android:layout_height="@dimen/headerViewHeight"
                android:layout_below="@+id/txt_app_version"
                android:layout_centerVertical="true"
                android:layout_marginLeft="5dp"
                android:layout_marginTop="9dp"
                android:layout_marginRight="5dp"
                android:layout_toLeftOf="@+id/txt_acc_type"
                android:background="#FFFF00" />

            <TextView
                android:id="@+id/txt_acc_type"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_app_version"
                android:layout_alignParentRight="true"
                android:layout_marginTop="5dp"
                android:layout_marginRight="@dimen/pad_5dp"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="admin"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />
        </RelativeLayout>


    </LinearLayout>

    <View

        android:id="@+id/view_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"
        android:layout_below="@+id/ll_head"

        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"
        android:background="@color/white" />

    <RelativeLayout
        android:id="@+id/rl_product_"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_line"
        android:layout_margin="@dimen/margin10"
        android:background="@color/grey_90">

        <RelativeLayout

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <TextView

                android:id="@+id/desc1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/margin10"
                android:layout_marginTop="@dimen/margin10"
                android:layout_marginBottom="@dimen/margin10"
                android:gravity="center_horizontal"
                android:text="Top it Up cannot be held liable for any losses or damages as a result of Card Fraud."
                android:textColor="@color/red"
                android:textSize="@dimen/pad_15dp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/desc1"
                android:layout_centerHorizontal="true"
                android:layout_marginLeft="@dimen/margin10"
                android:layout_marginBottom="@dimen/margin10"
                android:gravity="center_horizontal"
                android:text="Check that transactions are 'Successfully Approved' before handling over goods.
            Card holders can dispute transactions up to 6 months after sale. Please keep proof of sale (merchant copy) Multiple transactions with same card &amp; high sale value is not allowed within the same day."
                android:textColor="@color/grey_90"
                android:textSize="@dimen/spi_item_text_size_14dp" />
        </RelativeLayout>

    </RelativeLayout>

    <ImageView
        android:id="@+id/img_product"
        android:layout_width="100dp"
        android:layout_height="70dp"
        android:layout_below="@+id/rl_product_"
        android:layout_centerVertical="true"
        android:src="@drawable/prov_visa_" />

    <RelativeLayout
        android:id="@+id/rl_product"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rl_product_"
        android:layout_centerHorizontal="true"
        android:layout_toRightOf="@+id/img_product"
        android:gravity="center_horizontal">

        <TextView

            android:id="@+id/txt_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:text="Card Payment"
            android:textColor="@color/white"
            android:textSize="@dimen/pad_25dp"
            android:textStyle="bold"
            android:visibility="visible" />

        <TextView

            android:id="@+id/txt_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/txt_card"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:text="Amount R5"
            android:textColor="@color/white"
            android:textSize="@dimen/margin20"
            android:textStyle="bold"
            android:visibility="visible" />


    </RelativeLayout>

    <View
        android:id="@+id/view_line_1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"
        android:layout_below="@+id/rl_product"
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginTop="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"
        android:background="@color/white" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/view_line_1"
        android:layout_gravity="center"
        android:gravity="center">

        <TextView
            android:id="@+id/txt_cancel_amount"

            android:layout_width="@dimen/dialog_alarm_text_width"
            android:layout_height="@dimen/dialog_alarm_text_height"
            android:layout_marginStart="@dimen/pad_5dp"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginEnd="@dimen/pad_5dp"
            android:layout_marginBottom="@dimen/pad_5dp"
            android:background="@drawable/btn_rounded_red_new"
            android:gravity="center"
            android:text="Close"
            android:textColor="@color/white"

            android:textSize="@dimen/pad_15dp" />

        <TextView
            android:id="@+id/txt_proceed_amount"

            android:layout_width="@dimen/dialog_alarm_text_width"
            android:layout_height="@dimen/dialog_alarm_text_height"
            android:layout_marginStart="@dimen/pad_5dp"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginEnd="@dimen/pad_5dp"
            android:layout_marginBottom="@dimen/pad_5dp"
            android:layout_toRightOf="@+id/txt_cancel_amount"
            android:background="@drawable/btn_rounded_green"
            android:gravity="center"
            android:text="Proceed"
            android:textColor="@color/white"

            android:textSize="@dimen/pad_15dp" />
    </RelativeLayout>


</RelativeLayout>