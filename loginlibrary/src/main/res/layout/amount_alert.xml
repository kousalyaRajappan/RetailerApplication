<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_marginTop="5dp"
    android:layout_width="match_parent"
    android:background="@color/black"
    android:layout_height="match_parent">

    <LinearLayout
        android:padding="@dimen/pad_15dp"
        android:id="@+id/ll_head"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="23 jan 2023"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />

            <TextView
                android:id="@+id/txt_account"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:maxLines="1"
                android:layout_marginTop="5dp"
                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />

            <View
                android:visibility="gone"
                android:layout_below="@+id/txt_clock"

                android:layout_centerVertical="true"
                android:id="@+id/view2"
                android:layout_toRightOf="@+id/txt_account"
                android:layout_width="@dimen/view_2"
                android:layout_height="@dimen/headerViewHeight"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginLeft="4dp"/>

            <TextView
                android:id="@+id/txt_account_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txt_clock"
                android:layout_marginLeft="@dimen/pad_5dp"
                android:layout_toRightOf="@+id/view2"
                android:maxLines="1"
                android:layout_marginTop="5dp"

                android:text="ptg"
                android:textColor="#fff"
                android:textSize="@dimen/headtextSize" />
            <TextView


                android:layout_alignParentRight="true"
                android:id="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:visibility="visible"
                android:text="2.3"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/headtextSize" />

            <TextView
                android:layout_marginTop="5dp"

                android:layout_toLeftOf="@+id/view1"
                android:id="@+id/txt_user_name"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="username"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
            <View
                android:id="@+id/view1"
                android:layout_below="@+id/txt_app_version"

                android:layout_centerVertical="true"
                android:layout_toLeftOf="@+id/txt_acc_type"
                android:layout_width="@dimen/view_2"
                android:layout_height="@dimen/headerViewHeight"
                android:background="#FFFF00"
                android:layout_marginTop="9dp"
                android:layout_marginRight="5dp"
                android:layout_marginLeft="5dp"/>
            <TextView
                android:layout_marginTop="5dp"

                android:layout_alignParentRight="true"
                android:id="@+id/txt_acc_type"
                android:layout_below="@+id/txt_app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0"
                android:maxLength="24"
                android:text="admin"
                android:layout_marginRight="@dimen/pad_5dp"
                android:textSize="@dimen/headtextSize"
                android:textColor="#fff" />
        </RelativeLayout>


    </LinearLayout>

    <View
        android:id="@+id/view_line"
        android:layout_below="@+id/ll_head"
        android:layout_marginRight="@dimen/margin10"
        android:layout_marginLeft="@dimen/margin10"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"/>

    <RelativeLayout
        android:layout_below="@+id/view_line"

        android:layout_margin="@dimen/margin10"
        android:id="@+id/rl_product_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout

            android:layout_marginTop="@dimen/margin10"
            android:id="@+id/rl_product"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView

                android:id="@+id/img_product"
                android:src="@drawable/prov2"
                android:layout_width="@dimen/image_width"
                android:layout_height="@dimen/image_height"
                />

            <TextView

                android:layout_marginLeft="@dimen/margin10"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:text="cellc"
                android:textStyle="bold"
                android:textSize="@dimen/pad_30dp"
                android:layout_toRightOf="@+id/img_product"
                android:id="@+id/txt_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <TextView

            android:layout_marginBottom="@dimen/margin10"
            android:textSize="@dimen/pad_25dp"
            android:layout_marginTop="@dimen/margin10"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:layout_below="@+id/rl_product"
            android:layout_marginLeft="@dimen/margin10"
            android:textColor="@color/white"
            android:text="Input Amount "
            android:textStyle="bold"
            android:id="@+id/type_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>

    <TextView
        android:layout_gravity="center"
        android:id="@+id/pop_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/yellow"
        android:text="Max Amount Exceeded\n\nMaximum Amount Allowed = "
        android:layout_marginTop="5dp"
        android:textSize="@dimen/licence_edit_txt_size"

        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
        android:layout_marginLeft="5dp"
        android:textStyle="bold" />

    <RelativeLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txt_cancel_amount"

            android:layout_width="@dimen/dialog_alarm_text_width"
            android:layout_height="@dimen/dialog_alarm_text_height"
            android:layout_marginStart="@dimen/pad_5dp"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginEnd="@dimen/pad_5dp"
            android:layout_marginBottom="@dimen/pad_5dp"
            android:background="@drawable/btn_rounded_red_new"
            android:gravity="center"
            android:text="Close"
            android:textSize="@dimen/pad_15dp"

            android:textColor="@color/white" />

        <TextView
            android:id="@+id/txt_proceed_amount"

            android:layout_width="@dimen/dialog_alarm_text_width"
            android:layout_height="@dimen/dialog_alarm_text_height"
            android:layout_marginStart="@dimen/pad_5dp"
            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_marginEnd="@dimen/pad_5dp"
            android:layout_marginBottom="@dimen/pad_5dp"
            android:layout_toRightOf="@+id/txt_cancel_amount"
            android:background="@drawable/btn_rounded_green"
            android:gravity="center"
            android:text="Proceed"
            android:textSize="@dimen/pad_15dp"

            android:textColor="@color/white" />
    </RelativeLayout>





</LinearLayout>
