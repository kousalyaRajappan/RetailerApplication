<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_margin="24dp"
    card_view:cardCornerRadius="16dp"
    card_view:cardElevation="8dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Title -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WHOLESALER PAYMENTS"
                    android:textColor="#3F51FF"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_centerHorizontal="true"/>

                <ImageView
                    android:id="@+id/imgClose"
                    android:layout_width="30dp"
                    android:layout_height="25dp"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/close"
                    android:padding="4dp"
                    android:contentDescription="Close"/>
            </RelativeLayout>

            <!-- Wholesaler Info Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#EEF3FF"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSupplierName"
                    android:text=""
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="#3F51FF"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvLegalName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvAddress"
                    android:text=""
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvPhone"
                    android:text=""
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Account No -->
            <TextView
                android:text="RETAILER ACCOUNT NO"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etAccountNo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Enter Account No"
                android:background="@android:drawable/edit_text"
                android:padding="10dp"/>

            <!-- Amount -->
            <TextView
                android:text="AMOUNT (ZAR)"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>


            <RelativeLayout
                android:id="@+id/ll_amount_wrapper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:visibility="visible">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Clear -->
                    <ImageView
                        android:id="@+id/clearRand_Cents"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_delete"
                        android:contentDescription="Clear amount"/>

                    <!-- Rand -->
                    <EditText
                        android:id="@+id/dialogEditText"
                        android:layout_width="120dp"
                        android:layout_height="48dp"

                        android:hint="Rand"
                        android:inputType="number"
                        android:maxLength="6"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:background="@android:drawable/edit_text"
                        android:textSize="15sp"
                        android:importantForAccessibility="yes"/>

                    <!-- Dot -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="."
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:importantForAccessibility="no"/>

                    <!-- Cents -->
                    <EditText
                        android:id="@+id/dialogEditText_cent"
                        android:layout_width="120dp"
                        android:layout_height="48dp"
                        android:hint="Cents"
                        android:inputType="number"
                        android:maxLength="2"
                        android:gravity="center"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:background="@android:drawable/edit_text"
                        android:textSize="15sp"
                        android:importantForAccessibility="yes"/>

                    <!-- Error -->
                    <TextView
                        android:id="@+id/txt_rand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/red"
                        android:textSize="14sp"/>
                </LinearLayout>


            </RelativeLayout>

            <!-- Button -->
            <Button
                android:id="@+id/btnConfirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="CONFIRM PAYMENT"
                android:backgroundTint="#2FA84F"
                android:textColor="#FFFFFF"/>

        </LinearLayout>
    </ScrollView>

</androidx.cardview.widget.CardView>
