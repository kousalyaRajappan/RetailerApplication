<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="@dimen/recycler_item_horiz_width"
    card_view:cardPreventCornerOverlap="false"
    android:layout_height="@dimen/recycler_item_hori_height"
    android:layout_margin="7dp"
    card_view:cardCornerRadius="@dimen/margin4">

    <RelativeLayout

        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_gravity="top">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/recycler_horizantal_image_hight"
            android:scaleType="fitXY"
            android:src="@drawable/prov_cellc"
            />
        <!--android:tint="@android:color/holo_red_light"-->


        <TextView
            android:layout_marginBottom="5dp"
            android:id="@+id/textView"
            android:background="@drawable/corners_white"
            android:padding="@dimen/pad_3dp"
            android:layout_width="@dimen/recycler_horizantal_amount_width"
            android:layout_height="@dimen/recycler_horizantal_txt"
            android:layout_centerHorizontal="true"
            android:textColor="@android:color/background_dark"
            android:drawablePadding="0dp"
            android:text="R 150"
            android:gravity="center"
            android:layout_alignParentBottom="true"
            android:textStyle="bold"
            android:textSize="@dimen/horizantal_text_size"
             />

    </RelativeLayout>
</androidx.cardview.widget.CardView>