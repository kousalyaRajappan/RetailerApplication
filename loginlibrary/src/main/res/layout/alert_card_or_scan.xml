<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose Your Payment Method"
        android:textSize="@dimen/margin20"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="21dp"
        android:textColor="@color/black"
        android:textStyle="bold"/>

    <TextView
        android:id="@+id/total_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL AMOUNT : "
        android:visibility="visible"
        android:layout_marginTop="@dimen/margin8"
        android:textColor="@color/green"
        android:textSize="@dimen/pad_18dp"
        android:layout_gravity="center"
        android:textStyle="bold"/>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="18dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:layout_gravity="center"
        android:layout_marginEnd="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@color/light_gray">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/card_pay"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:paddingStart="@dimen/margin8"
                    android:paddingEnd="@dimen/margin8"

                    android:background="@drawable/hover_lyt"
                    android:src="@drawable/card_pay_icon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/black"
                    android:text="CARD PAY"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="or"
                android:textStyle="normal"
                android:textColor="@color/grey_40"
                android:textSize="@dimen/spi_item_text_size_14dp"
                android:padding="@dimen/margin10"
                android:layout_gravity="center"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <ImageView
                    android:id="@+id/scan_pay"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:paddingStart="@dimen/margin8"
                    android:layout_gravity="center"
                    android:paddingEnd="@dimen/margin8"
                    android:background="@drawable/hover_lyt"
                    android:src="@drawable/qr_scan_icon"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp"
                    android:layout_gravity="center"
                    android:textColor="@color/black"
                    android:text="SCAN PAY"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="@dimen/pad_18dp"/>
    <!--    <Button-->
    <!--        android:id="@+id/proceed_payment"-->
    <!--        android:layout_width="220dp"-->
    <!--        android:layout_height="wrap_content"-->
    <!--        android:layout_marginTop="6dp"-->
    <!--        android:background="@drawable/btn_rounded_green"-->
    <!--        android:gravity="center"-->
    <!--        android:visibility="gone"-->
    <!--        android:text="Proceed"-->
    <!--        android:layout_gravity="center"-->
    <!--        android:textColor="@color/white"/>-->
</LinearLayout>