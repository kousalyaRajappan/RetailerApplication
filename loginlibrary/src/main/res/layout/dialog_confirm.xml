<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#263238"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/admin_row_item_width"
        android:orientation="vertical"
        android:paddingTop="@dimen/margin10"
        android:paddingLeft="@dimen/pad_20dp"
        android:paddingRight="@dimen/pad_20dp">

        <TextView
            android:layout_gravity="center"
            android:gravity="center"
            android:id="@+id/pop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirmation"
            android:layout_marginTop="@dimen/pad_20dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Display1"
            android:textColor="@android:color/white"
            android:textStyle="bold" />
        <customfonts.MyTextView_Roboto_Medium
            android:visibility="gone"
            android:id="@+id/country"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/vw_hor"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingRight="@dimen/pad_20dp"
            android:text="Transfer Amount"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textColor="#ffffff"
            android:textSize="@dimen/pad_18dp" />


        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_marginLeft="@dimen/margin10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <customfonts.MyTextView_Roboto_Medium
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="From Wallet : "
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="#ffffff"
                android:textSize="@dimen/pad_18dp" />
            <customfonts.MyTextView_Roboto_Medium
                android:id="@+id/from"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="@dimen/pad_18dp" />

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_marginLeft="@dimen/margin10"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <customfonts.MyTextView_Roboto_Medium
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/vw_hor"
                android:gravity="center"
                android:text="To Wallet : "
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="#ffffff"
                android:textSize="@dimen/pad_18dp" />

            <customfonts.MyTextView_Roboto_Medium
                android:id="@+id/to"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bill"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="18dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_marginTop="8dp"
            android:layout_marginLeft="@dimen/margin10"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <customfonts.MyTextView_Roboto_Medium
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/country"
                android:gravity="center"
                android:text="Transfer Amount : "
                android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                android:textColor="#ffffff"
                android:textSize="@dimen/pad_18dp" />


            <customfonts.MyTextView_Roboto_Medium
                android:id="@+id/payamount"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bill"
                android:textAppearance="@style/TextAppearance.AppCompat.Large"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:textSize="@dimen/pad_18dp" />

        </LinearLayout>





        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:gravity="center"
            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bt_close"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/admin_row_item_width"
                android:layout_height="@dimen/admin_row_item_height"
                android:background="@drawable/btn_rounded_red"
                android:text="CANCEL"
                android:textColor="@android:color/white"
                android:textSize="@dimen/pad_15dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:layout_toRightOf="@+id/bt_close"
                android:id="@+id/bt_process_fin"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/admin_row_item_width"
                android:layout_height="@dimen/admin_row_item_height"
                android:background="@drawable/btn_rounded_green"
                android:text="TRANSFER"
                android:textColor="@android:color/white"
                android:textSize="@dimen/pad_15dp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:paddingTop="5dp">

            <TextView
                android:id="@+id/txt_last_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#ffffff" />

            <TextView
                android:paddingTop="@dimen/pad_15dp"
                android:id="@+id/txt_last_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textColor="#ffffff" />


        </RelativeLayout>

    </LinearLayout>

</RelativeLayout>