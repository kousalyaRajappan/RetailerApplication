<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginRight="15dp"
    android:layout_marginLeft="15dp"
    android:background="@color/black">


    <LinearLayout
        android:padding="@dimen/pad_15dp"
        android:id="@+id/ll_head"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

       <RelativeLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content">

           <TextView
               android:id="@+id/txt_clock"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:text="23 jan 2023"
               android:layout_marginLeft="@dimen/pad_5dp"
               android:textSize="@dimen/headtextSize"
               android:textColor="#fff" />

           <TextView
               android:id="@+id/txt_account"
               android:visibility="gone"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_below="@+id/txt_clock"
               android:layout_marginLeft="@dimen/pad_5dp"
               android:maxLines="1"
               android:layout_marginTop="5dp"
               android:text="ptg"
               android:textColor="#fff"
               android:textSize="@dimen/headtextSize" />

           <View
               android:visibility="gone"
               android:layout_below="@+id/txt_clock"

               android:layout_centerVertical="true"
               android:id="@+id/view2"
               android:layout_toRightOf="@+id/txt_account"
               android:layout_width="@dimen/view_2"
               android:layout_height="@dimen/headerViewHeight"
               android:background="#FFFF00"
               android:layout_marginTop="9dp"
               android:layout_marginLeft="4dp"/>

           <TextView
               android:id="@+id/txt_account_type"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_below="@+id/txt_clock"
               android:layout_marginLeft="@dimen/pad_5dp"
               android:layout_toRightOf="@+id/view2"
               android:maxLines="1"
               android:layout_marginTop="5dp"

               android:text="ptg"
               android:textColor="#fff"
               android:textSize="@dimen/headtextSize" />
           <TextView


               android:layout_alignParentRight="true"
               android:id="@+id/txt_app_version"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_weight="1"
               android:visibility="visible"
               android:text="2.3"
               android:textColor="#FFFFFF"
               android:textSize="@dimen/headtextSize" />

           <TextView
               android:layout_marginTop="5dp"

               android:layout_toLeftOf="@+id/view1"
               android:id="@+id/txt_user_name"
               android:layout_below="@+id/txt_app_version"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_weight="0"
               android:maxLength="24"
               android:text="username"
               android:layout_marginRight="@dimen/pad_5dp"
               android:textSize="@dimen/headtextSize"
               android:textColor="#fff" />
           <View
               android:id="@+id/view1"
               android:layout_below="@+id/txt_app_version"

               android:layout_centerVertical="true"
               android:layout_toLeftOf="@+id/txt_acc_type"
               android:layout_width="@dimen/view_2"
               android:layout_height="@dimen/headerViewHeight"
               android:background="#FFFF00"
               android:layout_marginTop="9dp"
               android:layout_marginRight="5dp"
               android:layout_marginLeft="5dp"/>
           <TextView
               android:layout_marginTop="5dp"

               android:layout_alignParentRight="true"
               android:id="@+id/txt_acc_type"
               android:layout_below="@+id/txt_app_version"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_weight="0"
               android:maxLength="24"
               android:text="admin"
               android:layout_marginRight="@dimen/pad_5dp"
               android:textSize="@dimen/headtextSize"
               android:textColor="#fff" />
       </RelativeLayout>


    </LinearLayout>

    <View

        android:id="@+id/view_line"
        android:layout_below="@+id/ll_head"
        android:layout_marginTop="@dimen/margin10"
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"

        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"/>

    <RelativeLayout
        android:layout_below="@+id/view_line"

        android:background="@color/grey_90"
        android:layout_margin="@dimen/margin10"
        android:id="@+id/rl_product_"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout

            android:layout_marginTop="@dimen/margin10"
            android:id="@+id/rl_product"
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView

                android:id="@+id/img_product"
                android:src="@drawable/prov2"
                android:layout_width="@dimen/image_width"
                android:layout_height="@dimen/image_height"
                />

            <TextView

                android:layout_marginLeft="@dimen/margin10"
                android:layout_centerVertical="true"
                android:textColor="@color/white"
                android:text="cellc"
                android:textStyle="bold"
                android:textSize="@dimen/pad_30dp"
                android:layout_toRightOf="@+id/img_product"
                android:id="@+id/txt_product_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>
        <TextView

            android:layout_marginBottom="@dimen/margin10"
            android:textSize="@dimen/pad_25dp"
            android:layout_marginTop="@dimen/margin10"
            android:layout_centerHorizontal="true"
            android:gravity="center_horizontal"
            android:layout_below="@+id/rl_product"
            android:layout_marginLeft="@dimen/margin10"
            android:textColor="@color/white"
            android:text="Cellc Data  30 MB"
            android:textStyle="bold"
            android:id="@+id/type_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>


    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:textStyle="bold"
        android:textSize="@dimen/pad_25dp"
        android:layout_centerHorizontal="true"
        android:gravity="center_horizontal"
        android:layout_below="@+id/rl_product_"
        android:layout_marginLeft="@dimen/margin10"
        android:textColor="@color/white"
        android:text="Amount R5"
        android:visibility="visible"
        android:id="@+id/txt_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <View
        android:layout_marginLeft="@dimen/margin10"
        android:layout_marginRight="@dimen/margin10"
        android:id="@+id/view_line_1"
        android:layout_below="@+id/txt_amount"
        android:layout_marginTop="@dimen/margin10"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="@dimen/view_1"/>
    <RelativeLayout
        android:visibility="visible"
        android:layout_marginTop="@dimen/margin10"
        android:id="@+id/rl_counter"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/view_line_1"
        android:layout_width="@dimen/pad_50dp"
        android:background="@color/white"
        android:layout_height="@dimen/pad_50dp">

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:indeterminate="false"
            android:progressDrawable="@drawable/circular_progress_bar"
            android:background="@drawable/circle_shape"
            style="?android:attr/progressBarStyleHorizontal"
            android:max="100"
            android:progress="65" />
        <TextView
            android:id="@+id/txt_count"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginLeft="@dimen/margin10"
            android:layout_marginTop="@dimen/margin10"
            android:text="15"
            android:textStyle="bold"
            android:textColor="@color/blue_lt"
            android:textSize="@dimen/pad_15dp" />
    </RelativeLayout>

    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:layout_centerHorizontal="true"
        android:textSize="@dimen/pad_20dp"
        android:gravity="center_horizontal"
        android:layout_below="@+id/rl_counter"
        android:textColor="@color/white"
        android:text="Printing"
        android:layout_marginBottom="@dimen/margin10"
        android:id="@+id/txt_printing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>


    <TextView
        android:layout_marginTop="@dimen/margin10"

        android:visibility="visible"
        android:textSize="@dimen/pad_15dp"
        android:layout_below="@+id/txt_printing"
        android:layout_marginLeft="@dimen/margin10"
        android:textColor="@color/android_robot"
        android:text="Your voucher is busy printing.\nIf you have an issue, please check Reprint  "
        android:id="@+id/txt_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ImageView
        android:visibility="gone"

        android:layout_below="@+id/txt_desc"
        android:layout_marginBottom="@dimen/margin10"
        android:layout_alignParentRight="true"
        android:id="@+id/img_reprint"
        android:layout_marginRight="@dimen/margin2.5"
        android:src="@drawable/main_reprint"
        android:layout_width="@dimen/rl_network_reprint_width"
        android:layout_height="@dimen/rl_network_reprint_height"
        />

    <TextView
        android:visibility="gone"
        android:layout_marginBottom="@dimen/margin10"
        android:background="@drawable/red_background"
        android:layout_below="@+id/txt_desc"
        android:layout_centerHorizontal="true"
        android:textColor="@color/white"
        android:id="@+id/txt_close"
        android:layout_width="70dp"
        android:textSize="@dimen/pad_15dp"
        android:gravity="center"
        android:layout_height="@dimen/pad_30dp"
        android:text="Close"/>
</RelativeLayout>