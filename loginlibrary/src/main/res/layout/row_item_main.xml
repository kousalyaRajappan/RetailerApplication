<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="@dimen/recycler_item_height_new"
    android:layout_margin="@dimen/margin2_"
    android:background="@color/blue"
    card_view:cardCornerRadius="4dp"
    card_view:cardElevation="@dimen/pad_40dp">

    <RelativeLayout
        android:id="@+id/relativeLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/prov_cellc"
            />
        <!--<ImageView
            android:layout_margin="@dimen/pad_5dp"
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:src="@drawable/prov_cellc"
            android:adjustViewBounds="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"

            android:contentDescription="@null"
            />-->
        <!--android:tint="@android:color/holo_red_light"-->


        <customfonts.MyTextView_Montserrat_Medium
            android:visibility="gone"
            android:id="@+id/textView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:textColor="@android:color/primary_text_light"
            android:drawablePadding="0dp"
            android:layout_marginBottom="2dp"
            android:gravity="center"
            android:textSize="@dimen/spi_item_text_size_14dp"
            android:layout_below="@+id/imageView" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>