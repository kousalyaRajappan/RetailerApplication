<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"

    android:orientation="vertical">



    <TextView
        android:visibility="visible"
        android:layout_marginTop="@dimen/margin20"
        android:layout_gravity="center_horizontal"
        android:textSize="@dimen/margin20"

        android:textColor="@color/black"
        android:text="Card Payment Alert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:textSize="@dimen/pad_15dp"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_margin="@dimen/margin10"
        android:textColor="@color/black"
        android:text="Your Account has not been setup for receiving Card Payment funds into your wallet."
        android:layout_height="wrap_content"/>

    <TextView
        android:textSize="@dimen/pad_15dp"
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_margin="@dimen/margin10"
        android:textColor="@color/black"
        android:text="Please contact Top it Up to enable your Account for Card Payment Settlement."
        android:layout_height="wrap_content"/>


    <RelativeLayout
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_marginRight="@dimen/pad_5dp"

            android:src="@drawable/ic_whatsapp"
            android:id="@+id/img_watsapp"
            android:layout_width="@dimen/pad_20dp"
            android:layout_height="@dimen/pad_20dp"/>

        <TextView
            android:textSize="@dimen/pad_15dp"

            android:layout_toRightOf="@+id/img_watsapp"
            android:text="064 121 9970"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/txt_ok"
        android:layout_marginBottom="@dimen/pad_20dp"
        android:layout_marginTop="@dimen/margin10"
        android:gravity="center"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        android:text="Ok"
        android:textSize="@dimen/pad_15dp"
        android:background="@drawable/background_blue"
        android:layout_width="@dimen/login_read_button_width"
        android:layout_height="@dimen/pad_40dp"/>

</LinearLayout>