<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#263238"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="120dp"
        android:orientation="vertical"
        android:paddingTop="@dimen/margin10"
        android:paddingLeft="@dimen/margin20"
        android:paddingRight="@dimen/margin20">

        <TextView
            android:id="@+id/pop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Summary"
            android:textSize="@dimen/login_invalid_text_size"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

            <customfonts.MyTextView_Roboto_Medium
                android:textSize="@dimen/txt_16sp"
                android:id="@+id/country"
                android:layout_below="@+id/pop_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:paddingRight="20dp"
                android:text=""
                android:textColor="#ffffff" />


                <customfonts.MyTextView_Roboto_Medium
                    android:textSize="@dimen/txt_16sp"
                    android:id="@+id/network"
                    android:layout_below="@+id/country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:text=""
                    android:textColor="#ffffff" />


                <customfonts.MyTextView_Roboto_Medium
                    android:textSize="@dimen/txt_16sp"

                android:id="@+id/phno"
                    android:layout_below="@+id/network"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text=""
                android:textColor="#ffffff" />


                <customfonts.MyTextView_Roboto_Medium
                    android:textSize="@dimen/txt_16sp"
                android:id="@+id/voucher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="left"
                android:text=""
                android:textColor="#ffffff" />

                <customfonts.MyTextView_Roboto_Medium
                    android:textSize="@dimen/txt_16sp"
                    android:id="@+id/amt"
                    android:layout_below="@+id/voucher"
                    android:layout_marginTop="@dimen/margin10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:background="#FFA500"
                    android:textStyle="bold"
                    android:text=""
                    android:textColor="@color/red" />



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:layout_marginTop="@dimen/pad_50dp"
            android:orientation="horizontal"
            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bt_close"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/spi_dark_dialog_img_width"
                android:layout_height="@dimen/pad_60dp"
                android:textSize="@dimen/pad_15dp"
                android:background="@drawable/btn_rounded_red"
                android:layout_alignParentLeft="true"
                android:text="CANCEL"
                android:textColor="@android:color/white" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/bt_process"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="@dimen/spi_marchent_copy_btn_width"
                android:layout_height="@dimen/pad_60dp"
                android:textSize="@dimen/pad_15dp"
                android:background="@drawable/btn_rounded_green"
                android:layout_alignParentRight="true"
                android:text="PROCESS"
                android:textColor="@android:color/white" />


        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:paddingTop="@dimen/pad_5dp">

            <TextView
                android:id="@+id/txt_last_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="@dimen/login_invalid_text_size"
                android:text=""
                android:textColor="#ffffff" />

            <TextView
                android:paddingTop="@dimen/pad_15dp"
                android:id="@+id/txt_last_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="@dimen/pad_15dp"
                android:text=""
                android:textColor="#ffffff" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/pad_30dp">

                <TextView
                    android:id="@+id/txt_last_voucher_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="left"
                    android:padding="@dimen/pad_10dp"
                    android:textSize="@dimen/login_invalid_text_size"
                    android:text=""
                    android:textColor="#ffffff" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/bt_reprint"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="@dimen/spi_marchent_copy_btn_width"
                    android:layout_height="@dimen/pad_50dp"
                    android:layout_alignParentRight="true"
                    android:background="@drawable/btn_rounded_red"
                    android:text="REPRINT"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/pad_15dp" />


            </RelativeLayout>



        </RelativeLayout>

    </LinearLayout>

</LinearLayout>