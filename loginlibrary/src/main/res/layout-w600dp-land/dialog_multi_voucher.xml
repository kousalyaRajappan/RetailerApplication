<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#263238"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingLeft="@dimen/margin20"
        android:paddingTop="@dimen/margin10"
        android:paddingRight="@dimen/margin20"

        >

        <TextView
            android:textSize="@dimen/pad_18dp"

            android:id="@+id/pop_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Quantity"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_toLeftOf="@+id/tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView

                    android:layout_centerHorizontal="true"
                    android:id="@+id/img_product1"
                    android:layout_width="@dimen/multi_voucher_img"
                    android:layout_height="@dimen/multi_voucher_img" />
                <TextView
                    android:layout_below="@+id/img_product1"
                    android:id="@+id/txt_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R 10"
                    android:textSize="@dimen/pad_18dp"

                    android:layout_centerHorizontal="true"
                    android:textColor="@color/white"
                    android:visibility="gone" />
                <androidx.appcompat.widget.AppCompatButton
                    android:layout_below="@+id/txt_value"
                    android:id="@+id/bt_reprint"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="@dimen/muliti_width"

                    android:layout_height="@dimen/main_bottom_size"
                    android:layout_gravity="left"
                    android:background="@drawable/btn_rounded_red"

                    android:text="REPRINT"
                    android:textColor="@android:color/white"

                    android:textSize="@dimen/pad_15dp" />

                <RelativeLayout
                    android:layout_below="@+id/bt_reprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/bt_close"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="@dimen/muliti_width"
                        android:layout_height="@dimen/main_bottom_size"
                        android:layout_alignParentLeft="true"
                        android:background="@drawable/btn_rounded_red"
                        android:text="CANCEL"
                        android:textColor="@android:color/white"

                        android:textSize="@dimen/pad_15dp" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/bt_process"
                        style="@style/Widget.AppCompat.Button.Borderless"
                        android:layout_width="@dimen/muliti_width"
                        android:layout_height="@dimen/main_bottom_size"
                        android:layout_alignParentRight="true"
                        android:background="@drawable/btn_rounded_green"
                        android:text="PROCESS"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/pad_15dp" />


                </RelativeLayout>
            </RelativeLayout>



            <TableLayout
                android:id="@+id/tab"
                android:layout_alignParentRight="true"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:visibility="visible">

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="2"
                        android:text="2"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                    <TextView
                        android:id="@+id/textView3"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="3"
                        android:text="3"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="4"
                        android:text="4"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="5"
                        android:text="5"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                </TableRow>


                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView6"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="6"
                        android:text="6"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/pad_10dp"
                        android:tag="7"
                        android:text="7"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                </TableRow>


                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/textView8"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/margin10"
                        android:tag="8"
                        android:text="8"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                    <TextView
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/tab_multi_height"
                        android:layout_margin="5dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_spi_multi"
                        android:gravity="center"
                        android:onClick="click_spi_multi"
                        android:padding="@dimen/pad_10dp"
                        android:tag="9"
                        android:text="9"
                        android:textAlignment="center"
                        android:textSize="@dimen/pad_25dp" />

                </TableRow>

            </TableLayout>

        </RelativeLayout>







