<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    card_view:cardCornerRadius="28dp"
    card_view:cardElevation="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#EAF2FF"
        android:padding="16dp">

        <!-- ================= HEADER ================= -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loyalty Awards"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_centerHorizontal="true"/>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"/>
        </RelativeLayout>

        <!-- ================= MAIN MESSAGE ================= -->
        <TextView
            android:id="@+id/tvWinText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Win R500"
            android:textColor="#E53935"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/tvDescText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If you reach sales > R30,000 on these products"
            android:textColor="#1E88E5"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="6dp"/>

        <!-- ================= PRODUCTS ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/prov_ott"
                android:layout_margin="8dp"/>

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/prov_blue"
                android:layout_margin="8dp"/>

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:src="@drawable/prov_one"
                android:layout_margin="8dp"/>
        </LinearLayout>

        <!-- ================= SEPARATOR ================= -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#9DB7E5"
            android:layout_marginTop="10dp"/>

        <!-- ================= WINNER IMAGE ================= -->
        <ImageView
            android:id="@+id/imgWinner"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_winner"
            android:layout_marginTop="12dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- ================= GOAL ACHIEVEMENT ================= -->
        <TextView
            android:id="@+id/tvGoalTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Goal Achievement"
            android:textColor="#E53935"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp"/>


        <TextView
            android:id="@+id/tvPercent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="55%"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="6dp"/>

        <!-- ================= INFO TEXT (MISSED CASE) ================= -->
        <TextView
            android:id="@+id/tvInfoText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="You achieved 57% of Target\nJoin us for the next Loyalty Programme"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginTop="12dp"/>

        <!-- ================= FOOTER ================= -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hurry, only 5 days left\nExpires on 30 June 2025"
            android:background="#E53935"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:gravity="center"
            android:padding="14dp"
            android:layout_marginTop="14dp"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
