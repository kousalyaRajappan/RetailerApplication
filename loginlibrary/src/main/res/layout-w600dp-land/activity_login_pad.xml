<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"

    android:keepScreenOn="true">

    <include layout="@layout/layout_tiu_header_new" />

    <ImageView
        android:layout_marginLeft="@dimen/pad_5dp"
        android:id="@+id/activity_login_admin"
        android:layout_width="@dimen/topitIconWidthSize"
        android:layout_height="@dimen/topitIconSize"
        android:layout_marginTop="@dimen/loginMarginHeader"
        android:background="@drawable/logo_splash"
        android:gravity="center"
        android:paddingTop="25dp"
        />


    <RelativeLayout
        android:id="@+id/btn_show_more_contact"

        android:layout_marginRight="@dimen/pad_5dp"
        android:layout_marginTop="@dimen/loginMarginHeader"
        android:layout_alignParentRight="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginRight="@dimen/pad_5dp"
            android:src="@drawable/ic_call_icon"
            android:id="@+id/img_call"
            android:layout_width="@dimen/loginWatsappHeight"
            android:layout_height="@dimen/loginWatsappHeight"/>
        <TextView
            android:layout_toRightOf="@+id/img_call"
            android:textSize="@dimen/loginWatsapptext"
            android:id="@+id/txt_call"
            android:text="0860 111 723"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <ImageView
            android:layout_below="@+id/txt_call"
            android:layout_marginRight="@dimen/pad_5dp"

            android:src="@drawable/ic_whatsapp"
            android:id="@+id/img_watsapp"
            android:layout_width="@dimen/loginWatsappHeight"
            android:layout_height="@dimen/loginWatsappHeight"/>

        <TextView
            android:textSize="@dimen/loginWatsapptext"

            android:layout_toRightOf="@+id/img_watsapp"
            android:layout_below="@+id/txt_call"
            android:text="064 121 9970"
            android:textColor="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </RelativeLayout>


    <RelativeLayout
        android:id="@+id/login_text_button_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/activity_login_admin"
        android:gravity="center">
        <TextView

            android:id="@+id/text_store_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:visibility="visible"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:layout_marginBottom="@dimen/pad_5dp"
            android:paddingRight="5dp"
            android:text=" Store Name"
            android:textStyle="bold"
            android:textColor="@color/indigo_500"
            android:textSize="@dimen/loginStoreTextSize"/>
        <Button
            android:visibility="gone"
            android:onClick="printmethod"
            android:text="Print"
            android:layout_width="100dp"
            android:layout_height="40dp"/>

        <RelativeLayout

            android:layout_below="@+id/text_store_name"
            android:id="@+id/activity_login_access_code_value"
            android:layout_width="match_parent"
            android:layout_height="@dimen/loginEdittextSize"

            android:layout_centerHorizontal="true"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:background="@drawable/login_pad_edit_text"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:gravity="center"
            android:textSize="30sp"

            >

            <ImageView
                android:layout_marginRight="@dimen/margin10"
                android:visibility="gone"
                android:layout_centerVertical="true"
                android:id="@+id/img_one"
                android:layout_width="@dimen/login_dot_size"
                android:layout_height="@dimen/login_dot_size"
                android:src="@drawable/dot_white" />

            <ImageView
                android:layout_marginRight="@dimen/margin10"

                android:layout_centerVertical="true"
                android:visibility="gone"

                android:layout_toRightOf="@id/img_one"
                android:id="@+id/img_two"
                android:layout_width="@dimen/login_dot_size"
                android:layout_height="@dimen/login_dot_size"
                android:src="@drawable/dot_white" />

            <ImageView
                android:layout_marginRight="@dimen/margin10"

                android:visibility="gone"

                android:layout_centerVertical="true"

                android:layout_toRightOf="@id/img_two"

                android:id="@+id/img_three"
                android:layout_width="@dimen/login_dot_size"
                android:layout_height="@dimen/login_dot_size"
                android:src="@drawable/dot_white" />

            <ImageView
                android:visibility="gone"
                android:layout_marginRight="65dp"
                android:layout_centerVertical="true"

                android:layout_toRightOf="@id/img_three"

                android:id="@+id/img_four"
                android:layout_width="@dimen/login_dot_size"
                android:layout_height="@dimen/login_dot_size"
                android:src="@drawable/dot_white" />

        </RelativeLayout>
        <RelativeLayout
            android:layout_below="@+id/text_store_name"
            android:visibility="gone"
            android:layout_centerHorizontal="true"

            android:background="@drawable/red_background"
            android:id="@+id/txt_invalid"

            android:layout_marginTop="@dimen/pad_5dp"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/login_dot_size">
            <ImageView
                android:id="@+id/img_close"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_close"
                android:layout_width="@dimen/login_invalid_img_size"
                android:layout_height="@dimen/login_invalid_img_size"/>
            <TextView
                android:layout_toRightOf="@+id/img_close"
                android:paddingRight="5dp"
                android:paddingLeft="@dimen/pad_5dp"
                android:layout_centerInParent="true"
                android:visibility="visible"
                android:textSize="@dimen/login_invalid_text_size"
                android:textColor="@color/white"
                android:text="Invalid Pin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </RelativeLayout>

        <RelativeLayout
            android:layout_alignRight="@+id/activity_login_access_code_value"

            android:layout_below="@+id/text_store_name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/loginEdittextSize">
            <ImageView
                android:layout_centerVertical="true"
                android:id="@+id/simpleImageView"
                android:layout_width="@dimen/clearbuttonwidth"
                android:layout_height="@dimen/clearbuttonheight"
                android:layout_marginTop="@dimen/clearbuttonmargintop"
                android:layout_marginRight="5dp"
                android:onClick="clear"
                android:scaleType="fitXY"
                android:src="@drawable/clear_button"
                android:visibility="visible" />
        </RelativeLayout>



        <TextView
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:layout_below="@+id/text_store_name"
            android:id="@+id/textLastSale"
            android:layout_width="match_parent"
            android:layout_height="@dimen/loginEdittextSize"
            android:layout_weight="1"
            android:paddingLeft="5dp"
            android:paddingRight="5dp"
            android:text=""
            android:layout_marginLeft="35dp"
            android:textColor="@color/black"
            android:textSize="@dimen/login_last_sale" />


    </RelativeLayout>

    <TableLayout
        android:visibility="visible"
        android:id="@+id/activity_login_pad_table_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/login_text_button_layout"

        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="0dp">

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/one_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="1"
                android:textColor="#811d1d"
                android:textSize="25dp" />

            <TextView
                android:id="@+id/two_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="2"
                android:textColor="#811d1d"
                android:textSize="25dp"/>

            <TextView
                android:id="@+id/three_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="3"
                android:textColor="#811d1d"
                android:textSize="25dp" />

        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/four_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="4"
                android:textColor="#811d1d"
                android:textSize="25dp" />

            <TextView
                android:id="@+id/five_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="5"
                android:textColor="#811d1d"
                android:textSize="25dp" />

            <TextView
                android:id="@+id/six_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="6"
                android:textColor="#811d1d"
                android:textSize="25dp"/>

        </TableRow>

        <TableRow
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="5dp">

            <TextView
                android:id="@+id/seven_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="7"
                android:textColor="#811d1d"
                android:textSize="25dp" />

            <TextView
                android:id="@+id/eight_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="8"
                android:textColor="#811d1d"
                android:textSize="25dp"/>

            <TextView
                android:id="@+id/nine_button"
                android:layout_width="@dimen/fifty_four_dp"
                android:layout_height="@dimen/fifty_four_dp_h"
                android:layout_marginLeft="@dimen/eight_dp"
                android:layout_marginRight="@dimen/eight_dp"
                android:background="@drawable/btn_login"
                android:gravity="center"
                android:paddingBottom="@dimen/two_dp"
                android:text="9"
                android:textColor="#811d1d"
                android:textSize="25dp"/>

        </TableRow>

    </TableLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/login_text_button_layout"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <WebView

            android:visibility="gone"
            android:layout_marginTop="@dimen/margin10"
            android:id="@+id/wb_notice"
            android:layout_width="200dp"
            android:layout_height="300dp"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="0dp"
            />

        <ImageView

            android:id="@+id/newImageView"
            android:layout_width="100dp"
            android:layout_height="60dp"
            android:layout_alignParentLeft="true"
            android:layout_marginLeft="0dp"
            android:paddingTop="5dp"
            android:src="@drawable/prov_new"
            android:visibility="gone" />
        <TextView
            android:visibility="gone"
            android:id="@+id/textView3"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_below="@+id/newImageView"
            android:layout_gravity="center_vertical|end"
            android:layout_marginTop="-5dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="left"
            android:maxLines="5"
            android:paddingLeft="30dp"
            android:paddingRight="30dp"
            android:paddingBottom="2dp"
            android:scrollbars="vertical"
            android:textSize="17sp" />

        <ImageView
            android:layout_marginTop="@dimen/margin10"
            android:layout_marginLeft="@dimen/margin10"
            android:id="@+id/img_gif_"
            android:layout_width="270dp"
            android:layout_height="300dp"
            android:layout_below="@+id/newImageView"
            android:layout_weight="1"


            android:src="@drawable/login_advertisement"
            android:layout_marginBottom="@dimen/margin10"
            android:scaleType="fitXY"
           />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:id="@+id/ll_demo"
            android:layout_marginBottom="58dp"
            android:orientation="horizontal">





        </LinearLayout>
    </RelativeLayout>
    <RelativeLayout
        android:layout_marginRight="@dimen/margin10"
        android:layout_below="@id/login_text_button_layout"
        android:layout_alignParentRight="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_marginTop="@dimen/margin10"
            android:id="@+id/rl_msg"
            android:background="@drawable/button_back_mes"
            android:layout_width="300dp"
            android:layout_height="130dp">
            <TextView
                android:layout_marginLeft="@dimen/pad_15dp"

                android:id="@+id/txt_msg"
                android:textSize="@dimen/pad_15dp"
                android:text="Messages"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <View
                android:layout_marginRight="@dimen/margin10"

                android:layout_marginLeft="@dimen/margin10"
                android:layout_below="@+id/txt_msg"
                android:background="@color/text_gray"
                android:layout_width="match_parent"
                android:layout_height="@dimen/view_1"/>
            
        </RelativeLayout>
        <RelativeLayout

            android:layout_below="@+id/rl_msg"
            android:layout_marginTop="@dimen/margin10"
            android:layout_width="300dp"
            android:layout_height="130dp">
            <TextView
                android:id="@+id/txt_1"
                android:background="@color/colorPrimary"
                android:textColor="@color/white"
                android:textSize="@dimen/pad_15dp"
                android:gravity="right"
                android:textStyle="italic|bold"
                android:text="Convenience at your      \n fingertips!     "
                android:layout_width="match_parent"
                android:layout_height="@dimen/pad_40dp"/>

            <TextView
                android:textStyle="italic|bold"
                android:background="@color/grey_40"
                android:layout_below="@+id/txt_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:gravity="right"
                android:text="Electricity  \n Airtime \u2022 Data \u2022 RICA   \n Bill Payments \u2022 Water      "
                android:textSize="@dimen/pad_15dp" />
        </RelativeLayout>


    </RelativeLayout>

    <ImageView


        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:contentDescription="0860 111 723"
        android:gravity="bottom|center_horizontal"
        android:scaleType="fitXY"
        android:src="@drawable/bottom" />

<LinearLayout
    android:weightSum="6"
    android:layout_alignParentBottom="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/pad_50dp">

    <LinearLayout
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:layout_weight="1"
        android:id="@+id/ll_message"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/pad_50dp">

        <ImageView
            android:layout_width="@dimen/pad_50dp"
            android:layout_height="@dimen/pad_50dp"
            android:layout_gravity="center"

            android:scaleType="fitXY"
            android:src="@drawable/ic_message_service" />

    </LinearLayout>

    <LinearLayout

        android:layout_weight="1"
        android:layout_toRightOf="@+id/ll_message"
        android:id="@+id/ll_banking_detail"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/login_bottom_tabs_size">

        <ImageView
            android:layout_gravity="center"
            android:src="@drawable/ic_banking_detail"
            android:layout_width="@dimen/pad_50dp"
            android:scaleType="fitXY"
            android:layout_height="@dimen/pad_50dp"
            />

    </LinearLayout>
    <LinearLayout
        android:layout_weight="1"
        android:layout_toRightOf="@+id/ll_banking_detail"
        android:id="@+id/ll_activation"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/pad_50dp">

        <ImageView
            android:src="@drawable/ic_activation_info"
            android:layout_gravity="center"
            android:layout_width="@dimen/pad_50dp"
            android:scaleType="fitXY"


            android:layout_height="@dimen/pad_50dp"            />

    </LinearLayout>
    <LinearLayout
        android:id="@+id/ll_calculator"
        android:layout_weight="1"
        android:layout_toRightOf="@+id/ll_activation"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="@dimen/pad_50dp">

        <ImageView
            android:layout_gravity="center"
            android:src="@drawable/ic_calculator"
            android:layout_width="@dimen/pad_50dp"
            android:scaleType="fitXY"
            android:layout_height="@dimen/pad_50dp"
            />
        />
    </LinearLayout>


</LinearLayout>
    <ProgressBar
        android:layout_marginTop="10dp"
        android:id="@+id/login_button_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:indeterminate="true"
        android:indeterminateTint="#036E07"
        android:paddingLeft="@dimen/two_dp"
        android:paddingRight="@dimen/two_dp" />
</RelativeLayout>